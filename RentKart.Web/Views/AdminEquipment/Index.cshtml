@model IEnumerable<RentKart.Core.Entities.Equipment>
@{
    ViewData["Title"] = "Manage Equipment";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-container mx-n3 mt-n3 mb-n3">
    <partial name="_AdminSidebar" />
    
    <main class="dashboard-main">
        <div class="dashboard-header d-flex justify-content-between align-items-center">
            <div>
                <h2 class="dashboard-title">Manage Equipment</h2>
                <p class="text-muted mb-0">Deactivate or moderate equipment listings across the platform.</p>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Equipment</th>
                                <th>Category</th>
                                <th>Business</th>
                                <th>Price/Day</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            @if (item.EquipmentImages != null && item.EquipmentImages.Any())
                                            {
                                                <img src="@item.EquipmentImages.First().ImagePath" class="rounded me-3 border" style="width: 40px; height: 40px; object-fit: cover;" alt="Img">
                                            }
                                            else
                                            {
                                                <div class="bg-light text-secondary rounded d-flex align-items-center justify-content-center me-3 border" style="width: 40px; height: 40px;">
                                                    <i class="bi bi-box"></i>
                                                </div>
                                            }
                                            <div>
                                                <h6 class="mb-0 fw-bold">@item.Name</h6>
                                                <small class="text-muted">@item.Brand @item.Model</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.Category?.Name</td>
                                    <td>@item.Business?.BusinessName</td>
                                    <td>@item.RentalPrice.ToString("C")</td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success rounded-pill">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger rounded-pill">Deactivated</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="isActive" value="@(item.IsActive ? "false" : "true")" />
                                            
                                            @if (item.IsActive)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to deactivate this listing?');">
                                                    <i class="bi bi-pause-circle me-1"></i> Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-play-circle me-1"></i> Activate
                                                </button>
                                            }
                                        </form>
                                        <a asp-controller="Equipment" asp-action="Details" asp-route-id="@item.Id" target="_blank" class="btn btn-sm btn-outline-secondary ms-1">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <p class="text-muted mb-0">No equipment found.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </main>
</div>

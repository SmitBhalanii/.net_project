@model IEnumerable<RentKart.Core.Entities.Review>
@using RentKart.Core.Enums
@{
    ViewData["Title"] = "Moderate Reviews";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-container mx-n3 mt-n3 mb-n3">
    <partial name="_AdminSidebar" />
    
    <main class="dashboard-main">
        <div class="dashboard-header">
            <div>
                <h2 class="dashboard-title">Moderate Reviews</h2>
                <p class="text-muted mb-0">Approve or reject customer reviews.</p>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Reviewer</th>
                                <th>Equipment</th>
                                <th>Rating</th>
                                <th>Comment</th>
                                <th>Date</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var review in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@review.Customer?.FirstName @review.Customer?.LastName</td>
                                    <td>
                                        <a asp-controller="Equipment" asp-action="Details" asp-route-id="@review.EquipmentId" target="_blank" class="text-decoration-none">
                                            @review.Equipment?.Name
                                        </a>
                                    </td>
                                    <td>
                                        <div class="text-warning">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= review.EquipmentRating ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 250px;" title="@review.Comment">
                                            @review.Comment
                                        </div>
                                    </td>
                                    <td>@review.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end pe-4">
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@review.Id" />
                                            <button type="submit" name="status" value="@ReviewStatus.Published" class="btn btn-sm btn-outline-success" title="Approve">
                                                <i class="bi bi-check-lg"></i> Approve
                                            </button>
                                            <button type="submit" name="status" value="@ReviewStatus.Rejected" class="btn btn-sm btn-outline-danger ms-1" title="Reject">
                                                <i class="bi bi-x-lg"></i> Reject
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <p class="text-muted mb-0">No pending reviews.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </main>
</div>

@model RentKart.Core.DTOs.Reports.BusinessDashboardDto
@{
    ViewData["Title"] = "Business Analytics";
}

<div class="d-flex">
    <!-- Business Sidebar matching existing style -->
    <aside class="dashboard-sidebar bg-white border-end" style="width: 250px; min-height: calc(100vh - 70px);">
        <div class="p-4">
            <h5 class="fw-bold text-primary mb-4">Business Dashboard</h5>
            <a asp-controller="BusinessDashboard" asp-action="Index" class="dashboard-nav-item"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a>
            <a asp-controller="Equipment" asp-action="MyEquipment" class="dashboard-nav-item"><i class="bi bi-camera me-2"></i> Equipment</a>
            <a asp-controller="Booking" asp-action="BusinessBookings" class="dashboard-nav-item"><i class="bi bi-calendar-check me-2"></i> Bookings</a>
            <a asp-controller="Rental" asp-action="BusinessRentals" class="dashboard-nav-item"><i class="bi bi-arrow-left-right me-2"></i> Rentals</a>
            <a asp-controller="VendorFinancial" asp-action="Index" class="dashboard-nav-item"><i class="bi bi-cash-stack me-2"></i> Financials</a>
            <a asp-controller="Notification" asp-action="Index" class="dashboard-nav-item"><i class="bi bi-bell me-2"></i> Notifications</a>
            <a asp-controller="Reports" asp-action="Business" class="dashboard-nav-item active"><i class="bi bi-file-earmark-bar-graph me-2"></i> Reports & Analytics</a>
        </div>
    </aside>

    <main class="flex-grow-1 p-4 bg-light">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0">Business Analytics</h2>
            
            <form method="get" class="d-flex gap-2 align-items-center bg-white p-2 rounded shadow-sm">
                <div>
                    <label class="form-label small mb-0">Start Date</label>
                    <input type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                </div>
                <div>
                    <label class="form-label small mb-0">End Date</label>
                    <input type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                </div>
                <div class="align-self-end">
                    <button type="submit" class="btn btn-primary btn-sm">Filter</button>
                    <a asp-action="Business" class="btn btn-outline-secondary btn-sm">Reset</a>
                </div>
            </form>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <!-- KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-4 col-lg-2">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body">
                        <h6 class="text-muted mb-2">Total Equipment</h6>
                        <h3 class="fw-bold text-info mb-0">@Model.TotalEquipment.ToString("N0")</h3>
                        <small class="text-muted">(@Model.ActiveEquipment active)</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-lg-2">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body">
                        <h6 class="text-muted mb-2">Bookings</h6>
                        <h3 class="fw-bold text-primary mb-0">@Model.TotalBookings.ToString("N0")</h3>
                        <small class="text-muted">(@Model.PendingBookings pending)</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-lg-2">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body">
                        <h6 class="text-muted mb-2">Active Rentals</h6>
                        <h3 class="fw-bold text-warning mb-0">@Model.ActiveRentals.ToString("N0")</h3>
                        <small class="text-danger">(@Model.OverdueRentals overdue)</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-lg-2">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body">
                        <h6 class="text-muted mb-2">Completed Rentals</h6>
                        <h3 class="fw-bold text-success mb-0">@Model.CompletedRentals.ToString("N0")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-lg-2">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body">
                        <h6 class="text-muted mb-2">Gross Revenue</h6>
                        <h3 class="fw-bold text-success mb-0">@Model.GrossRentalRevenue.ToString("C")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-lg-2">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body">
                        <h6 class="text-muted mb-2">Avg Rating</h6>
                        <h3 class="fw-bold text-warning mb-0">
                            @if(Model.AverageRating > 0)
                            {
                                <span><i class="bi bi-star-fill"></i> @Model.AverageRating.ToString("F1")</span>
                            }
                            else
                            {
                                <span class="fs-6 text-muted">Not Rated</span>
                            }
                        </h3>
                        <small class="text-muted">(@Model.TotalReviews reviews)</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <!-- Revenue Trend -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0 fw-bold">Gross Revenue Trend (Last 12 Months)</h5>
                    </div>
                    <div class="card-body">
                        <canvas id="revenueTrendChart" style="max-height: 300px;"></canvas>
                    </div>
                </div>
            </div>
            
            <!-- Booking Status -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0 fw-bold">Booking Status</h5>
                    </div>
                    <div class="card-body">
                        @if (!Model.BookingStatusDistribution.Any())
                        {
                            <p class="text-muted text-center">No data available for the selected period.</p>
                        }
                        else
                        {
                            <canvas id="bookingStatusChart" style="max-height: 250px;"></canvas>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Equipment Performance Table -->
            <div class="col-12">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0 fw-bold">Equipment Performance</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Equipment</th>
                                    <th>Category</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-center">Bookings</th>
                                    <th class="text-center">Completed Rentals</th>
                                    <th class="text-end">Revenue</th>
                                    <th class="text-center">Avg Rating</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.EquipmentPerformance.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">No data available.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.EquipmentPerformance)
                                    {
                                        <tr>
                                            <td class="fw-bold">@item.EquipmentName</td>
                                            <td>@item.CategoryName</td>
                                            <td class="text-center">
                                                <span class="badge bg-secondary">@item.Status</span>
                                            </td>
                                            <td class="text-center">@item.Bookings</td>
                                            <td class="text-center">@item.CompletedRentals</td>
                                            <td class="text-end fw-bold text-success">@item.Revenue.ToString("C")</td>
                                            <td class="text-center">
                                                @if (item.AverageRating > 0)
                                                {
                                                    <span><i class="bi bi-star-fill text-warning"></i> @item.AverageRating.ToString("F1")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not Rated</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0 fw-bold">Category Performance</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Category</th>
                                    <th class="text-center">Total Equipment</th>
                                    <th class="text-center">Rentals</th>
                                    <th class="text-end">Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.CategoryPerformance.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">No data available.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.CategoryPerformance)
                                    {
                                        <tr>
                                            <td class="fw-bold">@item.CategoryName</td>
                                            <td class="text-center">@item.EquipmentCount</td>
                                            <td class="text-center">@item.RentalCount</td>
                                            <td class="text-end fw-bold text-success">@item.Revenue.ToString("C")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                
            </div>
        </div>

    </main>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            
            // Revenue Trend Chart
            const revenueTrendCtx = document.getElementById('revenueTrendChart')?.getContext('2d');
            if (revenueTrendCtx) {
                const periods = @Html.Raw(Json.Serialize(Model.RevenueTrend.Select(r => r.Period)));
                const revenues = @Html.Raw(Json.Serialize(Model.RevenueTrend.Select(r => r.Revenue)));
                
                new Chart(revenueTrendCtx, {
                    type: 'line',
                    data: {
                        labels: periods,
                        datasets: [{
                            label: 'Revenue (?)',
                            data: revenues,
                            borderColor: '#198754',
                            backgroundColor: 'rgba(25, 135, 84, 0.1)',
                            borderWidth: 2,
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true } }
                    }
                });
            }
            
            // Booking Status Chart
            const bookingStatusCtx = document.getElementById('bookingStatusChart')?.getContext('2d');
            if (bookingStatusCtx) {
                const statuses = @Html.Raw(Json.Serialize(Model.BookingStatusDistribution.Select(b => b.Status)));
                const counts = @Html.Raw(Json.Serialize(Model.BookingStatusDistribution.Select(b => b.Count)));
                
                new Chart(bookingStatusCtx, {
                    type: 'doughnut',
                    data: {
                        labels: statuses,
                        datasets: [{
                            data: counts,
                            backgroundColor: ['#ffc107', '#198754', '#dc3545', '#6c757d', '#0d6efd'],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }
        });
    </script>
}

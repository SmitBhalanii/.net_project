@model RentKart.Web.ViewModels.BusinessRegisterViewModel
@{
    ViewData["Title"] = "Partner with RentKart";
}

@section Styles {
    <style>
        .business-reg-wrapper {
            display: flex;
            min-height: calc(100vh - 80px);
            background-color: #f8f9fa;
            margin: -16px; /* Negate main container padding if any */
        }
        
        .reg-banner {
            flex: 1;
            background: linear-gradient(135deg, rgba(255, 62, 108, 0.95) 0%, rgba(255, 107, 107, 0.95) 100%), url('https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&q=80') center/cover;
            color: white;
            padding: 4rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .reg-banner::after {
            content: '';
            position: absolute;
            bottom: 0;
            right: 0;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 70%);
            border-radius: 50%;
            transform: translate(30%, 30%);
        }

        .reg-banner-content {
            max-width: 480px;
            position: relative;
            z-index: 2;
        }

        .reg-banner-title {
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 1.5rem;
            line-height: 1.2;
        }

        .reg-banner-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin-bottom: 2rem;
            line-height: 1.6;
        }

        .perk-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .perk-item {
            display: flex;
            align-items: center;
            margin-bottom: 1rem;
            font-size: 1.1rem;
        }

        .perk-icon {
            background: rgba(255,255,255,0.2);
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            backdrop-filter: blur(5px);
        }

        .reg-form-container {
            flex: 1.2;
            padding: 4rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background: white;
        }

        .reg-form-card {
            width: 100%;
            max-width: 600px;
        }

        .form-header {
            margin-bottom: 2.5rem;
        }

        .form-header h2 {
            color: #2b3445;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .form-header p {
            color: #7d879c;
        }

        .form-floating > .form-control,
        .form-floating > .form-control:focus {
            border-radius: 12px;
            border: 1px solid #e3e9ef;
            background-color: #f6f9fc;
            box-shadow: none;
            transition: all 0.3s ease;
        }

        .form-floating > .form-control:focus {
            border-color: #ff3e6c;
            background-color: #fff;
            box-shadow: 0 0 0 4px rgba(255, 62, 108, 0.1);
        }

        .form-floating > label {
            color: #7d879c;
        }

        .btn-register {
            background: linear-gradient(135deg, #ff3e6c 0%, #ff6b6b 100%);
            border: none;
            border-radius: 12px;
            color: white;
            padding: 14px;
            font-weight: 600;
            font-size: 1.1rem;
            margin-top: 1rem;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .btn-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 62, 108, 0.3);
            color: white;
        }

        @@media (max-width: 992px) {
            .business-reg-wrapper {
                flex-direction: column;
            }
            .reg-banner {
                padding: 3rem 2rem;
            }
            .reg-form-container {
                padding: 3rem 1.5rem;
            }
        }
    </style>
}

<div class="business-reg-wrapper">
    <div class="reg-banner d-none d-lg-flex">
        <div class="reg-banner-content">
            <h1 class="reg-banner-title">Grow Your Rental Business</h1>
            <p class="reg-banner-subtitle">Join thousands of local businesses earning more by listing their inventory on RentKart's marketplace.</p>
            
            <ul class="perk-list">
                <li class="perk-item">
                    <span class="perk-icon"><i class="bi bi-graph-up"></i></span>
                    Reach thousands of local customers daily
                </li>
                <li class="perk-item">
                    <span class="perk-icon"><i class="bi bi-shield-check"></i></span>
                    Secure payments and deposit handling
                </li>
                <li class="perk-item">
                    <span class="perk-icon"><i class="bi bi-calendar-check"></i></span>
                    Smart booking and inventory management
                </li>
                <li class="perk-item">
                    <span class="perk-icon"><i class="bi bi-headset"></i></span>
                    24/7 dedicated merchant support
                </li>
            </ul>
        </div>
    </div>

    <div class="reg-form-container">
        <div class="reg-form-card">
            <div class="form-header">
                <h2>Create Business Account</h2>
                <p>Start listing your equipment in minutes.</p>
            </div>
            
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="OwnerName" class="form-control" aria-required="true" placeholder="Owner Name" />
                            <label asp-for="OwnerName">Owner Name</label>
                            <span asp-validation-for="OwnerName" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="BusinessName" class="form-control" aria-required="true" placeholder="Business Name" />
                            <label asp-for="BusinessName">Business Name</label>
                            <span asp-validation-for="BusinessName" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Email">Business Email</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="PhoneNumber" class="form-control" aria-required="true" placeholder="Phone Number" />
                            <label asp-for="PhoneNumber">Phone Number</label>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Address" class="form-control" aria-required="true" placeholder="Street Address" />
                    <label asp-for="Address">Street Address</label>
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-5">
                        <div class="form-floating">
                            <input asp-for="City" class="form-control" aria-required="true" placeholder="City" />
                            <label asp-for="City">City</label>
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="State" class="form-control" aria-required="true" placeholder="State" />
                            <label asp-for="State">State</label>
                            <span asp-validation-for="State" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-floating">
                            <input asp-for="PostalCode" class="form-control" aria-required="true" placeholder="Zip" />
                            <label asp-for="PostalCode">Zip</label>
                            <span asp-validation-for="PostalCode" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="form-floating mb-4">
                    <textarea asp-for="Description" class="form-control" placeholder="Tell us about your business" style="height: 100px"></textarea>
                    <label asp-for="Description">Business Description</label>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Password" type="password" />
                            <label asp-for="Password">Password</label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm" type="password" />
                            <label asp-for="ConfirmPassword">Confirm Password</label>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <button type="submit" class="w-100 btn btn-register">Create Business Account</button>
                
                <div class="text-center mt-4">
                    <span class="text-muted">Already have a partner account? <a asp-action="Login" class="text-decoration-none fw-semibold" style="color: #ff3e6c;">Log in</a></span>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


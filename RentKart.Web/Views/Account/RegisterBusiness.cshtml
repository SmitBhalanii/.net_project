@model RentKart.Web.ViewModels.BusinessRegisterViewModel
@{
    ViewData["Title"] = "Business Registration";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-container">
    <div class="auth-card auth-card-wide">
        <div class="auth-header">
            <i class="bi bi-shop auth-logo"></i>
            <h2 class="auth-title">List Your Business on RentKart</h2>
        </div>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input asp-for="OwnerName" class="form-control" aria-required="true" placeholder="Owner Name" />
                        <label asp-for="OwnerName">Owner Name</label>
                        <span asp-validation-for="OwnerName" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input asp-for="BusinessName" class="form-control" aria-required="true" placeholder="Business Name" />
                        <label asp-for="BusinessName">Business Name</label>
                        <span asp-validation-for="BusinessName" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Email">Email</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input asp-for="PhoneNumber" class="form-control" aria-required="true" placeholder="Phone Number" />
                        <label asp-for="PhoneNumber">Phone Number</label>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Address" class="form-control" aria-required="true" placeholder="Address" />
                <label asp-for="Address">Address</label>
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <div class="form-floating">
                        <input asp-for="City" class="form-control" aria-required="true" placeholder="City" />
                        <label asp-for="City">City</label>
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="form-floating">
                        <input asp-for="State" class="form-control" aria-required="true" placeholder="State" />
                        <label asp-for="State">State</label>
                        <span asp-validation-for="State" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="form-floating">
                        <input asp-for="PostalCode" class="form-control" aria-required="true" placeholder="Postal Code" />
                        <label asp-for="PostalCode">Postal Code</label>
                        <span asp-validation-for="PostalCode" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="form-floating mb-3">
                <textarea asp-for="Description" class="form-control" placeholder="Description" style="height: 100px"></textarea>
                <label asp-for="Description">Description</label>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input asp-for="Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" type="password" />
                        <label asp-for="Password">Password</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="form-floating">
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" type="password" />
                        <label asp-for="ConfirmPassword">Confirm Password</label>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary mb-3">Register Business</button>
            
            <div class="text-center">
                <span class="text-muted small">Already have an account? <a asp-action="Login" class="text-primary text-decoration-none">Log in</a></span>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

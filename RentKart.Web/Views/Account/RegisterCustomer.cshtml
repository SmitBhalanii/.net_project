@model RentKart.Web.ViewModels.CustomerRegisterViewModel
@{
    ViewData["Title"] = "Customer Registration";
}

@section Styles {
    <style>
        .customer-reg-wrapper {
            display: grid;
            grid-template-columns: 1fr 1fr;
            min-height: calc(100vh - 72px - 200px);
            background-color: #f8f9fa;
        }
        
        .reg-banner {
            flex: 1;
            background: linear-gradient(135deg, rgba(0, 166, 153, 0.95) 0%, rgba(32, 201, 151, 0.95) 100%), url('https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&q=80') center/cover;
            color: white;
            padding: 4rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .reg-banner::after {
            content: '';
            position: absolute;
            bottom: 0;
            right: 0;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 70%);
            border-radius: 50%;
            transform: translate(30%, 30%);
        }

        .reg-banner-content {
            max-width: 480px;
            position: relative;
            z-index: 2;
        }

        .reg-banner-title {
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 1.5rem;
            line-height: 1.2;
        }

        .reg-banner-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin-bottom: 2rem;
            line-height: 1.6;
        }

        .perk-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .perk-item {
            display: flex;
            align-items: center;
            margin-bottom: 1rem;
            font-size: 1.1rem;
        }

        .perk-icon {
            background: rgba(255,255,255,0.2);
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            backdrop-filter: blur(5px);
        }

        .reg-form-container {
            padding: 40px 24px;
            display: flex;
            background: white;
        }

        .reg-form-card {
            width: 100%;
            max-width: 500px;
            margin: auto;
        }

        .form-header {
            margin-bottom: 2.5rem;
        }

        .form-header h2 {
            color: #2b3445;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .form-header p {
            color: #7d879c;
        }

        .form-floating > .form-control,
        .form-floating > .form-control:focus {
            border-radius: 12px;
            border: 1px solid #e3e9ef;
            background-color: #f6f9fc;
            box-shadow: none;
            transition: all 0.3s ease;
        }

        .form-floating > .form-control:focus {
            border-color: #00A699;
            background-color: #fff;
            box-shadow: 0 0 0 4px rgba(0, 166, 153, 0.1);
        }

        .form-floating > label {
            color: #7d879c;
        }

        .btn-register {
            background: linear-gradient(135deg, #00A699 0%, #20c997 100%);
            border: none;
            border-radius: 12px;
            color: white;
            padding: 14px;
            font-weight: 600;
            font-size: 1.1rem;
            margin-top: 1rem;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .btn-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 166, 153, 0.3);
            color: white;
        }

        @@media (max-width: 992px) {
            .customer-reg-wrapper {
                grid-template-columns: 1fr;
            }
            .reg-banner {
                padding: 3rem 2rem;
            }
            .reg-form-container {
                padding: 3rem 1.5rem;
            }
        }
    </style>
}

<div class="customer-reg-wrapper">
    <div class="reg-banner d-none d-lg-flex">
        <div class="reg-banner-content">
            <h1 class="reg-banner-title">Rent What You Need, When You Need It.</h1>
            <p class="reg-banner-subtitle">Join the leading marketplace for renting equipment, tools, and party gear locally.</p>
            
            <ul class="perk-list">
                <li class="perk-item">
                    <span class="perk-icon"><i class="bi bi-tag"></i></span>
                    Save money by renting instead of buying
                </li>
                <li class="perk-item">
                    <span class="perk-icon"><i class="bi bi-geo-alt"></i></span>
                    Find items from neighbors and local shops
                </li>
                <li class="perk-item">
                    <span class="perk-icon"><i class="bi bi-shield-check"></i></span>
                    Secure bookings and verified providers
                </li>
            </ul>
        </div>
    </div>

    <div class="reg-form-container">
        <div class="reg-form-card">
            <div class="form-header">
                <h2>Create Account</h2>
                <p>Start discovering rentals near you.</p>
            </div>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="FirstName" class="form-control" aria-required="true" placeholder="First Name" />
                            <label asp-for="FirstName">First Name</label>
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="LastName" class="form-control" aria-required="true" placeholder="Last Name" />
                            <label asp-for="LastName">Last Name</label>
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Email">Email Address</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="PhoneNumber" class="form-control" aria-required="true" placeholder="Phone Number" />
                    <label asp-for="PhoneNumber">Phone Number</label>
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" type="password" />
                            <label asp-for="Password">Password</label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" type="password" />
                            <label asp-for="ConfirmPassword">Confirm Password</label>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <button type="submit" class="w-100 btn btn-register">Create Account</button>
                
                <div class="text-center mt-4">
                    <span class="text-muted">Already have an account? <a asp-action="Login" class="text-decoration-none fw-semibold" style="color: #00A699;">Log in</a></span>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model RentKart.Core.Entities.Payment
@{
    ViewData["Title"] = "Payment Details";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Payment Details</h2>
        <a asp-action="MyPayments" class="btn btn-outline-secondary">Back to My Payments</a>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 font-monospace">@Model.PaymentReference</h5>
                    <div>
                        @if (Model.PaymentStatus == RentKart.Core.Enums.PaymentStatus.Succeeded)
                        {
                            <span class="badge bg-success fs-6">Paid</span>
                        }
                        else if (Model.PaymentStatus == RentKart.Core.Enums.PaymentStatus.Failed)
                        {
                            <span class="badge bg-danger fs-6">Failed</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark fs-6">@Model.PaymentStatus.ToString()</span>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Booking Number:</div>
                        <div class="col-sm-8">
                            <a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.BookingId">@Model.Booking.BookingNumber</a>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Amount:</div>
                        <div class="col-sm-8 fs-5 text-primary">@Model.Amount.ToString("c") (@Model.Currency)</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Payment Method:</div>
                        <div class="col-sm-8">@Model.PaymentMethod.ToString()</div>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(Model.TransactionReference))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold">Transaction Ref:</div>
                            <div class="col-sm-8 font-monospace text-muted">@Model.TransactionReference</div>
                        </div>
                    }

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Created On:</div>
                        <div class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                    
                    @if (Model.PaidAt.HasValue)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold">Paid On:</div>
                            <div class="col-sm-8">@Model.PaidAt.Value.ToString("dd MMM yyyy HH:mm")</div>
                        </div>
                    }
                </div>
            </div>
            
            @if (Model.PaymentStatus == RentKart.Core.Enums.PaymentStatus.Failed && Model.Booking.Status == RentKart.Core.Enums.BookingStatus.Approved)
            {
                <div class="alert alert-warning">
                    <h5 class="alert-heading">Payment Failed</h5>
                    <p>This payment attempt was not successful. The booking is still approved and awaiting payment.</p>
                    <hr>
                    <a asp-action="Create" asp-route-bookingId="@Model.BookingId" class="btn btn-primary">Try Payment Again</a>
                </div>
            }
        </div>
    </div>
</div>

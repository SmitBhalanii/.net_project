@model RentKart.Web.ViewModels.Payment.PaymentCreateViewModel
@using RentKart.Core.Enums

@{
    ViewData["Title"] = "Complete Rental Payment";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="mb-4">Complete Rental Payment</h2>
            
            <div class="alert alert-warning mb-4">
                <strong><i class="bi bi-exclamation-triangle-fill me-2"></i> DEMO PAYMENT — NO REAL MONEY WILL BE CHARGED</strong>
                <p class="mb-0">This is a demonstration payment gateway for the college project MVP. Do not enter real financial information.</p>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Booking Summary</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Booking</div>
                        <div class="col-sm-8 fw-bold">@Model.BookingNumber</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Equipment</div>
                        <div class="col-sm-8">@Model.EquipmentName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Business</div>
                        <div class="col-sm-8">@Model.BusinessName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Rental Period</div>
                        <div class="col-sm-8">@Model.StartDate.ToString("dd MMM yyyy") &rarr; @Model.EndDate.ToString("dd MMM yyyy")</div>
                    </div>
                    
                    <hr />
                    
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Rental Amount</div>
                        <div class="col-sm-8">@Model.RentalAmount.ToString("c")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Security Deposit</div>
                        <div class="col-sm-8">@Model.SecurityDeposit.ToString("c")</div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-sm-4 text-muted fw-bold">Amount Payable</div>
                        <div class="col-sm-8 fw-bold fs-4 text-primary">@Model.TotalAmount.ToString("c")</div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Select Payment Method</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Process" method="post">
                        <input type="hidden" asp-for="BookingId" />
                        
                        <div class="mb-4">
                            <div class="form-check mb-3 p-3 border rounded">
                                <input class="form-check-input ms-1" type="radio" name="paymentMethod" id="methodCard" value="@PaymentMethod.MockCard" checked>
                                <label class="form-check-label ms-2 fw-bold" for="methodCard">
                                    <i class="bi bi-credit-card me-2 text-primary"></i> Demo Card
                                    <small class="d-block text-muted fw-normal mt-1">Simulates a successful credit/debit card payment.</small>
                                </label>
                            </div>
                            
                            <div class="form-check mb-3 p-3 border rounded">
                                <input class="form-check-input ms-1" type="radio" name="paymentMethod" id="methodUPI" value="@PaymentMethod.MockUPI">
                                <label class="form-check-label ms-2 fw-bold" for="methodUPI">
                                    <i class="bi bi-phone me-2 text-primary"></i> Demo UPI
                                    <small class="d-block text-muted fw-normal mt-1">Simulates a successful UPI transfer.</small>
                                </label>
                            </div>

                            <div class="form-check p-3 border rounded border-danger bg-light">
                                <input class="form-check-input ms-1" type="radio" name="paymentMethod" id="methodFail" value="999">
                                <label class="form-check-label ms-2 fw-bold text-danger" for="methodFail">
                                    <i class="bi bi-x-circle me-2"></i> Demo Failure (Test Option)
                                    <small class="d-block text-muted fw-normal mt-1">Simulates a declined or failed payment attempt.</small>
                                </label>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                Continue to Demo Payment
                            </button>
                            <a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@model RentKart.Core.Entities.Payment
@{
    ViewData["Title"] = "Payment Successful";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
            <h2 class="mt-3 mb-4">Payment Successful</h2>
            <p class="lead">Your demo payment has been processed successfully.</p>
        </div>
    </div>

    <div class="row justify-content-center mt-4">
        <div class="col-md-8">
            <div class="card shadow-sm border-success">
                <div class="card-body p-4">
                    <div class="row mb-3 pb-3 border-bottom">
                        <div class="col-sm-4 text-muted">Booking</div>
                        <div class="col-sm-8 fw-bold">@Model.Booking.BookingNumber</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Payment Reference</div>
                        <div class="col-sm-8">@Model.PaymentReference</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Transaction ID</div>
                        <div class="col-sm-8 font-monospace text-muted">@Model.TransactionReference</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Payment Method</div>
                        <div class="col-sm-8">@Model.PaymentMethod.ToString()</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Status</div>
                        <div class="col-sm-8">
                            <span class="badge bg-success">Paid</span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Date</div>
                        <div class="col-sm-8">@Model.PaidAt?.ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                    
                    <div class="row mt-4 pt-3 border-top bg-light rounded p-2">
                        <div class="col-sm-4 text-muted fw-bold d-flex align-items-center">Amount Paid</div>
                        <div class="col-sm-8 fw-bold fs-3 text-success">@Model.Amount.ToString("c")</div>
                    </div>
                </div>
                <div class="card-footer bg-white border-top-0 text-center pb-4 pt-0">
                    <a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-primary me-2">View Booking</a>
                    <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-outline-secondary">My Bookings</a>
                </div>
            </div>
        </div>
    </div>
</div>

@model RentKart.Core.Entities.Business
@using RentKart.Core.Enums
@{
    ViewData["Title"] = "Business Details";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-container mx-n3 mt-n3 mb-n3">
    <partial name="_AdminSidebar" />
    
    <main class="dashboard-main">
        <div class="dashboard-header d-flex justify-content-between align-items-center">
            <div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-2"><i class="bi bi-arrow-left"></i> Back to Businesses</a>
                <h2 class="dashboard-title">@Model.BusinessName</h2>
                <p class="text-muted mb-0">Business Profile Details</p>
            </div>
            <div>
                @{
                    var badgeClass = Model.ApprovalStatus switch
                    {
                        BusinessApprovalStatus.Approved => "bg-success",
                        BusinessApprovalStatus.Pending => "bg-warning text-dark",
                        BusinessApprovalStatus.Suspended => "bg-danger",
                        BusinessApprovalStatus.Rejected => "bg-secondary",
                        _ => "bg-secondary"
                    };
                }
                <span class="badge @badgeClass rounded-pill fs-6 px-3 py-2">@Model.ApprovalStatus</span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="card-title fw-bold border-bottom pb-2 mb-3">Business Information</h5>
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted">Owner Name</div>
                            <div class="col-sm-8 fw-semibold">@Model.OwnerName</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted">Email Address</div>
                            <div class="col-sm-8">@Model.Email</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted">Phone Number</div>
                            <div class="col-sm-8">@Model.PhoneNumber</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted">Address</div>
                            <div class="col-sm-8">
                                @Model.Address<br />
                                @Model.City, @Model.State @Model.PostalCode
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted">Description</div>
                            <div class="col-sm-8">@Model.Description</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted">Joined On</div>
                            <div class="col-sm-8">@Model.CreatedAt.ToString("f")</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="card-title fw-bold border-bottom pb-2 mb-3">Actions</h5>
                        <form asp-action="UpdateStatus" method="post" class="mb-3">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-3">
                                <label for="reason" class="form-label text-muted small">Reason (optional)</label>
                                <textarea name="reason" id="reason" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="d-grid gap-2">
                                @if (Model.ApprovalStatus != BusinessApprovalStatus.Approved)
                                {
                                    <button type="submit" name="status" value="@BusinessApprovalStatus.Approved" class="btn btn-success"><i class="bi bi-check-circle me-2"></i> Approve Business</button>
                                }
                                @if (Model.ApprovalStatus != BusinessApprovalStatus.Suspended)
                                {
                                    <button type="submit" name="status" value="@BusinessApprovalStatus.Suspended" class="btn btn-danger"><i class="bi bi-pause-circle me-2"></i> Suspend Business</button>
                                }
                                @if (Model.ApprovalStatus == BusinessApprovalStatus.Pending)
                                {
                                    <button type="submit" name="status" value="@BusinessApprovalStatus.Rejected" class="btn btn-secondary"><i class="bi bi-x-circle me-2"></i> Reject Business</button>
                                }
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

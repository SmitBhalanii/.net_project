@model IEnumerable<RentKart.Core.Entities.Business>
@using RentKart.Core.Enums
@{
    ViewData["Title"] = "Manage Businesses";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-container mx-n3 mt-n3 mb-n3">
    <partial name="_AdminSidebar" />
    
    <main class="dashboard-main">
        <div class="dashboard-header">
            <div>
                <h2 class="dashboard-title">Manage Businesses</h2>
                <p class="text-muted mb-0">Approve or suspend marketplace vendors.</p>
            </div>
        </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Business</th>
                            <th>Owner</th>
                            <th>Location</th>
                            <th>Created</th>
                            <th>Listings</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(item.LogoPath))
                                        {
                                            <img src="@item.LogoPath" class="rounded-circle me-3 border" style="width: 40px; height: 40px; object-fit: cover;" alt="Logo">
                                        }
                                        else
                                        {
                                            <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                @item.BusinessName.Substring(0, 1).ToUpper()
                                            </div>
                                        }
                                        <div>
                                            <h6 class="mb-0 fw-bold">@item.BusinessName</h6>
                                            <small class="text-muted">@item.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.OwnerName</td>
                                <td>@item.City, @item.State</td>
                                <td>@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>@item.Equipment.Count</td>
                                <td>
                                    @{
                                        var badgeClass = item.ApprovalStatus switch
                                        {
                                            BusinessApprovalStatus.Approved => "bg-success",
                                            BusinessApprovalStatus.Pending => "bg-warning text-dark",
                                            BusinessApprovalStatus.Suspended => "bg-danger",
                                            BusinessApprovalStatus.Rejected => "bg-secondary",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass rounded-pill">@item.ApprovalStatus</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                            Actions
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            <li>
                                                <a class="dropdown-item" asp-controller="Business" asp-action="Details" asp-route-id="@item.Id" target="_blank"><i class="bi bi-eye me-2"></i> View Profile</a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            @if (item.ApprovalStatus != BusinessApprovalStatus.Approved)
                                            {
                                                <li>
                                                    <form asp-action="UpdateStatus" method="post">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="status" value="@BusinessApprovalStatus.Approved" />
                                                        <button type="submit" class="dropdown-item text-success"><i class="bi bi-check-circle me-2"></i> Approve</button>
                                                    </form>
                                                </li>
                                            }
                                            @if (item.ApprovalStatus != BusinessApprovalStatus.Suspended)
                                            {
                                                <li>
                                                    <form asp-action="UpdateStatus" method="post">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="status" value="@BusinessApprovalStatus.Suspended" />
                                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-pause-circle me-2"></i> Suspend</button>
                                                    </form>
                                                </li>
                                            }
                                            @if (item.ApprovalStatus == BusinessApprovalStatus.Pending)
                                            {
                                                <li>
                                                    <form asp-action="UpdateStatus" method="post">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="status" value="@BusinessApprovalStatus.Rejected" />
                                                        <button type="submit" class="dropdown-item text-secondary"><i class="bi bi-x-circle me-2"></i> Reject</button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <p class="text-muted mb-0">No businesses found.</p>
                    </div>
                }
            </div>
        </div>
    </div>
    </main>
</div>

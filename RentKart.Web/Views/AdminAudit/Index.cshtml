@model IEnumerable<RentKart.Core.Entities.AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-container mx-n3 mt-n3 mb-n3">
    <partial name="_AdminSidebar" />
    
    <main class="dashboard-main">
        <div class="dashboard-header">
            <div>
                <h2 class="dashboard-title">Audit Logs</h2>
                <p class="text-muted mb-0">System-wide record of critical platform actions.</p>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Timestamp</th>
                                <th>Action</th>
                                <th>Entity</th>
                                <th>Entity ID</th>
                                <th>User ID</th>
                                <th class="pe-4">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-nowrap">@log.CreatedAt.ToString("g")</td>
                                    <td><span class="badge bg-secondary">@log.Action</span></td>
                                    <td>@log.EntityName</td>
                                    <td>@log.EntityId</td>
                                    <td class="text-truncate" style="max-width:150px;" title="@log.UserId">@log.UserId</td>
                                    <td class="pe-4">@log.Description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <p class="text-muted mb-0">No audit logs found.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </main>
</div>

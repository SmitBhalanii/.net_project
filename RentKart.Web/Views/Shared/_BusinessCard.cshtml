@model RentKart.Web.ViewModels.Business.BusinessCardViewModel

<div class="rk-card h-100 d-flex flex-column">
    <div class="rk-card-body text-center p-4 flex-grow-1">
        @if (!string.IsNullOrEmpty(Model.LogoPath))
        {
            <img src="@Model.LogoPath" alt="@Model.BusinessName" class="rounded-circle mb-3 border" style="width: 80px; height: 80px; object-fit: cover;">
        }
        else
        {
            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
                @Model.BusinessName.Substring(0, 1).ToUpper()
            </div>
        }
        <h4 class="rk-card-title mt-2 mb-1">@Model.BusinessName</h4>
        <p class="text-muted small mb-2"><i class="bi bi-geo-alt"></i> @Model.City, @Model.State</p>
        
        @if (Model.IsApproved)
        {
            <div class="mb-3">
                <span class="badge bg-success rounded-pill px-3"><i class="bi bi-check-circle me-1"></i> RentKart Approved</span>
            </div>
        }

        <p class="rk-card-subtitle text-truncate-2 mt-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
            @(string.IsNullOrEmpty(Model.Description) ? "Professional rental business." : Model.Description)
        </p>
    </div>
    <div class="bg-white border-top-0 pt-0 pb-4 px-4 text-center mt-auto">
        <div class="d-flex justify-content-center align-items-center mb-3 text-muted small fw-bold">
            <span class="bg-light px-3 py-1 rounded-pill"><i class="bi bi-box-seam text-primary"></i> @Model.EquipmentCount Listings</span>
        </div>
        <a asp-controller="Business" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary w-100 rounded-pill fw-bold">View Business</a>
    </div>
</div>

@model int

<li class=""nav-item me-3"">
    <a class=""nav-link position-relative"" asp-controller=""Notification"" asp-action=""Index"" title=""Notifications"">
        <i class=""bi bi-bell fs-5""></i>
        <span id=""header-unread-badge"" class=""position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"" style=""font-size: 0.65rem; display: @(Model > 0 ? "inline-block" : "none");"">
            <span id=""header-unread-count"">@Model</span>
            <span class=""visually-hidden"">unread notifications</span>
        </span>
    </a>
</li>

@model IEnumerable<RentKart.Core.Entities.WishlistItem>

@{
    ViewData["Title"] = "My Wishlist";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Wishlist</h2>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info d-flex align-items-center flex-column py-5">
        <i class="bi bi-heart text-muted mb-3" style="font-size: 3rem;"></i>
        <h4>Your wishlist is empty.</h4>
        <p class="text-muted">Save equipment you like to easily find them later.</p>
        <a asp-action="Index" asp-controller="Home" class="btn btn-primary mt-2">Explore Equipment</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            var isAvailable = item.Equipment.Status == RentKart.Core.Enums.EquipmentStatus.Active;

            <div class="col">
                <div class="card h-100 shadow-sm @(isAvailable ? "" : "opacity-75")">
                    <img src="@(item.Equipment.EquipmentImages?.FirstOrDefault()?.ImagePath ?? "/images/placeholder.jpg")" 
                         class="card-img-top" alt="@item.Equipment.Name" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title text-truncate mb-0" title="@item.Equipment.Name">@item.Equipment.Name</h5>
                            <span class="badge bg-primary">₹@item.Equipment.RentalPrice / @item.Equipment.RentalPeriod</span>
                        </div>
                        <p class="card-text text-muted small mb-2"><i class="bi bi-shop me-1"></i> @item.Equipment.Business.BusinessName</p>
                        
                        @if (!isAvailable)
                        {
                            <div class="badge bg-secondary mb-3 d-block w-100 text-start py-2">
                                <i class="bi bi-info-circle me-1"></i> Currently unavailable
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-white border-top-0 pt-0 d-flex justify-content-between">
                        <a asp-action="Details" asp-controller="Equipment" asp-route-id="@item.EquipmentId" class="btn btn-sm btn-outline-primary w-100 me-2">View Equipment</a>
                        <form asp-action="Remove" asp-controller="Wishlist" method="post" class="d-inline">
                            <input type="hidden" name="equipmentId" value="@item.EquipmentId" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove from Wishlist">
                                <i class="bi bi-heart-fill"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

@model RentKart.Core.Entities.Category
@{
    ViewData["Title"] = "Create Category";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-container mx-n3 mt-n3 mb-n3">
    <partial name="_AdminSidebar" />
    
    <main class="dashboard-main">
        <div class="dashboard-header">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-2"><i class="bi bi-arrow-left"></i> Back</a>
            <h2 class="dashboard-title">Create Category</h2>
            <p class="text-muted mb-0">Add a new equipment category to the marketplace.</p>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <form asp-action="Create">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label fw-bold"></label>
                                <input asp-for="Name" class="form-control" placeholder="e.g. Power Tools" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label fw-bold"></label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Category description..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ImagePath" class="form-label fw-bold">Image Path</label>
                                <input asp-for="ImagePath" class="form-control" placeholder="e.g. /images/categories/tools.png" />
                                <div class="form-text">Path to the category image.</div>
                                <span asp-validation-for="ImagePath" class="text-danger small"></span>
                            </div>

                            <div class="mb-4 form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" checked>
                                <label class="form-check-label fw-bold" for="isActiveSwitch">Category is active</label>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-2"></i> Create Category</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@{
    ViewData["Title"] = "Business Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-container mx-n3 mt-n3 mb-n3">
    <aside class="dashboard-sidebar d-none d-md-block">
        <div class="p-3">
            <h6 class="text-muted fw-bold mb-3 px-2">BUSINESS</h6>
            <a asp-controller="BusinessDashboard" asp-action="Index" class="dashboard-nav-item active"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a>
            <a asp-controller="Business" asp-action="MyBusiness" class="dashboard-nav-item"><i class="bi bi-shop me-2"></i> My Business</a>
            <a asp-controller="Equipment" asp-action="Index" class="dashboard-nav-item"><i class="bi bi-box me-2"></i> Equipment</a>
            <a asp-controller="BusinessBooking" asp-action="Index" class="dashboard-nav-item"><i class="bi bi-calendar-check me-2"></i> Bookings</a>
            <a asp-controller="Payment" asp-action="MyPayments" class="dashboard-nav-item"><i class="bi bi-wallet2 me-2"></i> Payments</a>
            <a asp-controller="Rental" asp-action="Index" class="dashboard-nav-item"><i class="bi bi-bag-check me-2"></i> Rentals</a>
            <a asp-controller="Business" asp-action="Edit" class="dashboard-nav-item"><i class="bi bi-person me-2"></i> Profile</a>
            <a asp-controller="Notification" asp-action="Index" class="dashboard-nav-item">
                <i class="bi bi-bell me-2"></i> Notifications
                @if (ViewBag.UnreadNotificationCount != null && ViewBag.UnreadNotificationCount > 0)
                {
                    <span class="badge bg-danger ms-1">@ViewBag.UnreadNotificationCount</span>
                }
            </a>
        </div>
    </aside>
    
    <main class="dashboard-main">
        <div class="dashboard-header">
            <div>
                <h2 class="dashboard-title">Welcome to Your RentKart Business</h2>
                <p class="text-muted mb-0">Manage your rental business from here.</p>
            </div>
            <button class="btn btn-primary"><i class="bi bi-plus me-1"></i> Add Equipment</button>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="dashboard-stat-card text-center">
                    <div class="dashboard-stat-title">Ready for Pickup</div>
                    <div class="dashboard-stat-value">@(ViewBag.ReadyForPickup ?? 0)</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="dashboard-stat-card text-center">
                    <div class="dashboard-stat-title">Active Rentals</div>
                    <div class="dashboard-stat-value">@(ViewBag.ActiveRentals ?? 0)</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="dashboard-stat-card text-center">
                    <div class="dashboard-stat-title">Today's Returns</div>
                    <div class="dashboard-stat-value">@(ViewBag.TodayReturns ?? 0)</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="dashboard-stat-card text-center text-danger">
                    <div class="dashboard-stat-title text-danger">Overdue Rentals</div>
                    <div class="dashboard-stat-value">@(ViewBag.OverdueRentals ?? 0)</div>
                </div>
            </div>
        </div>
        
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 fw-bold">Recent Notifications</h5>
                <a asp-controller="Notification" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (ViewBag.RecentNotifications != null && ((IEnumerable<RentKart.Web.ViewModels.Notification.NotificationViewModel>)ViewBag.RecentNotifications).Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var notification in (IEnumerable<RentKart.Web.ViewModels.Notification.NotificationViewModel>)ViewBag.RecentNotifications)
                        {
                            <a asp-controller="Notification" asp-action="Index" class="list-group-item list-group-item-action p-3 @(!notification.IsRead ? "bg-light border-start border-primary border-4" : "")">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1 fw-bold">@notification.Title</h6>
                                    <small class="text-muted">@notification.CreatedAt.ToString("g")</small>
                                </div>
                                <p class="mb-1">@notification.Message</p>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        No recent notifications.
                    </div>
                }
            </div>
        </div>
    </main>
</div>

@{
    ViewData["Title"] = "Business Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-container mx-n3 mt-n3 mb-n3">
    <aside class="dashboard-sidebar d-none d-md-block">
        <div class="p-3">
            <h6 class="text-muted fw-bold mb-3 px-2">BUSINESS</h6>
            <a href="#" class="dashboard-nav-item active"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a>
            <a href="#" class="dashboard-nav-item"><i class="bi bi-shop me-2"></i> My Shop</a>
            <a href="#" class="dashboard-nav-item"><i class="bi bi-box me-2"></i> Equipment</a>
            <a href="#" class="dashboard-nav-item"><i class="bi bi-calendar-check me-2"></i> Bookings</a>
            <a href="#" class="dashboard-nav-item"><i class="bi bi-person me-2"></i> Profile</a>
        </div>
    </aside>
    
    <main class="dashboard-main">
        <div class="dashboard-header">
            <div>
                <h2 class="dashboard-title">Welcome to Your RentKart Business</h2>
                <p class="text-muted mb-0">Manage your rental business from here.</p>
            </div>
            <button class="btn btn-primary"><i class="bi bi-plus me-1"></i> Add Equipment</button>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="dashboard-stat-card text-center">
                    <div class="dashboard-stat-title">Active Listings</div>
                    <div class="dashboard-stat-value">0</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="dashboard-stat-card text-center">
                    <div class="dashboard-stat-title">Pending Bookings</div>
                    <div class="dashboard-stat-value">0</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="dashboard-stat-card text-center">
                    <div class="dashboard-stat-title">Total Revenue</div>
                    <div class="dashboard-stat-value">₹0</div>
                </div>
            </div>
        </div>
    </main>
</div>

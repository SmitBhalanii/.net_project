@model RentKart.Web.ViewModels.Booking.BookingDetailsViewModel
@{
    ViewData["Title"] = "Booking Details";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Booking Details</h2>
        <a asp-action="MyBookings" class="btn btn-outline-secondary">Back to My Bookings</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Booking #@Model.BookingNumber</h5>
                    <div>
                        @if (Model.Status == RentKart.Core.Enums.BookingStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark fs-6">Pending</span>
                        }
                        else if (Model.Status == RentKart.Core.Enums.BookingStatus.Approved)
                        {
                            <span class="badge bg-success fs-6">Approved</span>
                        }
                        else if (Model.Status == RentKart.Core.Enums.BookingStatus.Rejected)
                        {
                            <span class="badge bg-danger fs-6">Rejected</span>
                        }
                        else if (Model.Status == RentKart.Core.Enums.BookingStatus.Cancelled)
                        {
                            <span class="badge bg-secondary fs-6">Cancelled</span>
                        }
                        else
                        {
                            <span class="badge bg-info fs-6">@Model.Status</span>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Equipment:</div>
                        <div class="col-sm-8">@Model.EquipmentName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Provider:</div>
                        <div class="col-sm-8">@Model.BusinessName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Rental Dates:</div>
                        <div class="col-sm-8">@Model.StartDate.ToString("dd MMM yyyy") to @Model.EndDate.ToString("dd MMM yyyy") (@Model.RentalDays days)</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Created On:</div>
                        <div class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.CustomerNote))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold">Your Note:</div>
                            <div class="col-sm-8 text-muted fst-italic">"@Model.CustomerNote"</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.BusinessNote))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold">Business Note:</div>
                            <div class="col-sm-8 text-primary fst-italic">"@Model.BusinessNote"</div>
                        </div>
                    }
                </div>
            </div>
            
            @if (Model.Status == RentKart.Core.Enums.BookingStatus.Pending || Model.Status == RentKart.Core.Enums.BookingStatus.Approved)
            {
                <div class="card shadow-sm border-danger">
                    <div class="card-body text-center">
                        <h5 class="text-danger">Cancel Booking</h5>
                        <p class="text-muted">If you no longer need this equipment, you can cancel your request.</p>
                        <form asp-action="Cancel" method="post" onsubmit="return confirm('Are you sure you want to cancel this booking? This action cannot be undone.');">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-danger">Cancel Booking</button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Payment Summary</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Daily Rate:</span>
                        <span>@Model.DailyRate.ToString("c")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Rental Days:</span>
                        <span>@Model.RentalDays</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Rental Amount:</span>
                        <span>@Model.RentalAmount.ToString("c")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                        <span>Security Deposit:</span>
                        <span>@Model.SecurityDeposit.ToString("c")</span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Total:</span>
                        <span>@Model.TotalAmount.ToString("c")</span>
                    </div>
                </div>
                <div class="card-footer text-muted small text-center">
                    Payment is handled offline during pickup.
                </div>
            </div>
        </div>
    </div>
</div>

@model RentKart.Web.ViewModels.Booking.BookingCreateViewModel
@{
    ViewData["Title"] = "Request Rental";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="mb-4">Request Rental</h2>
            
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h4>@Model.EquipmentName</h4>
                    <p class="text-muted">Provided by: @Model.BusinessName</p>
                    <p class="fs-5 mb-0"><strong>@Model.DailyRate.ToString("c")</strong> / day</p>
                    @if (Model.SecurityDeposit > 0)
                    {
                        <p class="text-muted small">Security Deposit: @Model.SecurityDeposit.ToString("c")</p>
                    }
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" method="post" id="bookingForm">
                        <input type="hidden" asp-for="EquipmentId" />
                        <input type="hidden" id="dailyRate" value="@Model.DailyRate" />
                        <input type="hidden" id="securityDeposit" value="@Model.SecurityDeposit" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label"></label>
                                <input asp-for="StartDate" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="calculateTotal()" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label"></label>
                                <input asp-for="EndDate" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="calculateTotal()" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CustomerNote" class="form-label"></label>
                            <textarea asp-for="CustomerNote" class="form-control" rows="3" placeholder="Any special requests or details about your rental..."></textarea>
                            <span asp-validation-for="CustomerNote" class="text-danger"></span>
                        </div>

                        <div class="alert alert-light border">
                            <h5 class="mb-3">Rental Summary</h5>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Rental Days:</span>
                                <span id="rentalDays">0</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Rental Amount:</span>
                                <span id="rentalAmount">₹0.00</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Security Deposit:</span>
                                <span id="depositAmount">@Model.SecurityDeposit.ToString("c")</span>
                            </div>
                            <hr />
                            <div class="d-flex justify-content-between fw-bold fs-5">
                                <span>Total:</span>
                                <span id="totalAmount">₹0.00</span>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold">Proceed to Summary</button>
                            <a asp-controller="Marketplace" asp-action="Details" asp-route-id="@Model.EquipmentId" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function calculateTotal() {
            var startDateVal = document.getElementById('StartDate').value;
            var endDateVal = document.getElementById('EndDate').value;
            
            if (startDateVal && endDateVal) {
                var start = new Date(startDateVal);
                var end = new Date(endDateVal);
                
                var diffTime = end - start;
                var rentalDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
                
                if (rentalDays > 0) {
                    var dailyRate = parseFloat(document.getElementById('dailyRate').value);
                    var securityDeposit = parseFloat(document.getElementById('securityDeposit').value);
                    
                    var rentalAmount = rentalDays * dailyRate;
                    var total = rentalAmount + securityDeposit;
                    
                    document.getElementById('rentalDays').innerText = rentalDays;
                    document.getElementById('rentalAmount').innerText = '₹' + rentalAmount.toFixed(2);
                    document.getElementById('totalAmount').innerText = '₹' + total.toFixed(2);
                } else {
                    document.getElementById('rentalDays').innerText = 0;
                    document.getElementById('rentalAmount').innerText = '₹0.00';
                    document.getElementById('totalAmount').innerText = '₹0.00';
                }
            }
        }

        // Calculate initially
        document.addEventListener('DOMContentLoaded', calculateTotal);
    </script>
}

@model RentKart.Web.Models.ViewModels.EquipmentEditViewModel
@using RentKart.Core.Enums
@{
    ViewData["Title"] = "Edit Equipment";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <div class="card mt-4">
        <div class="card-body">
            <form asp-action="Edit" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Brand" class="form-label"></label>
                        <input asp-for="Brand" class="form-control" />
                        <span asp-validation-for="Brand" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Model" class="form-label"></label>
                        <input asp-for="Model" class="form-control" />
                        <span asp-validation-for="Model" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="RentalPrice" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="RentalPrice" class="form-control" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="RentalPrice" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="RentalPeriod" class="form-label"></label>
                        <select asp-for="RentalPeriod" class="form-select" asp-items="Html.GetEnumSelectList<RentalPeriod>()"></select>
                        <span asp-validation-for="RentalPeriod" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="SecurityDeposit" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="SecurityDeposit" class="form-control" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="SecurityDeposit" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Quantity" class="form-label"></label>
                        <input asp-for="Quantity" class="form-control" type="number" />
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Condition" class="form-label"></label>
                        <select asp-for="Condition" class="form-select" asp-items="Html.GetEnumSelectList<EquipmentCondition>()"></select>
                        <span asp-validation-for="Condition" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<EquipmentStatus>()"></select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                </div>

                <h5 class="mt-4 mb-3">Location Details</h5>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="State" class="form-label"></label>
                        <input asp-for="State" class="form-control" />
                        <span asp-validation-for="State" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="PostalCode" class="form-label"></label>
                        <input asp-for="PostalCode" class="form-control" />
                        <span asp-validation-for="PostalCode" class="text-danger"></span>
                    </div>
                </div>

                <h5 class="mt-4 mb-3">Images</h5>
                @if (Model.ExistingImages != null && Model.ExistingImages.Any())
                {
                    <div class="mb-3">
                        <label class="form-label">Existing Images</label>
                        <div class="row">
                            @foreach (var img in Model.ExistingImages)
                            {
                                <div class="col-md-3 mb-3">
                                    <div class="card h-100">
                                        <img src="@img.ImagePath" class="card-img-top" alt="Equipment Image" style="object-fit: cover; height: 150px;">
                                        <div class="card-body text-center">
                                            <div class="form-check d-inline-block">
                                                <input class="form-check-input" type="checkbox" name="ImagesToDelete" value="@img.Id" id="deleteImg_@img.Id">
                                                <label class="form-check-label text-danger" for="deleteImg_@img.Id">
                                                    Delete
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                
                <div class="mb-3">
                    <label asp-for="NewImages" class="form-label">Add New Images</label>
                    <input asp-for="NewImages" class="form-control" type="file" multiple accept="image/*" />
                    <div class="form-text">You can upload multiple new images.</div>
                    <span asp-validation-for="NewImages" class="text-danger"></span>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

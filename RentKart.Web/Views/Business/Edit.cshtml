@model RentKart.Web.ViewModels.Business.BusinessEditViewModel
@{
    ViewData["Title"] = "Edit Business Profile";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h3 class="fw-bold">@ViewData["Title"]</h3>
                    <p class="text-muted">Update your marketplace business information.</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="LogoPath" />

                        @if (!string.IsNullOrEmpty(Model.LogoPath))
                        {
                            <div class="mb-4 text-center">
                                <img src="@Model.LogoPath" alt="Current Logo" class="rounded-circle border" style="width: 100px; height: 100px; object-fit: cover;" />
                                <div class="mt-2 text-muted small">Current Logo</div>
                            </div>
                        }

                        <h5 class="fw-bold mb-3 border-bottom pb-2">Basic Details</h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="BusinessName" class="form-label fw-semibold"></label>
                                <input asp-for="BusinessName" class="form-control" />
                                <span asp-validation-for="BusinessName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LogoFile" class="form-label fw-semibold">Upload New Logo (Optional)</label>
                                <input asp-for="LogoFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
                                <span asp-validation-for="LogoFile" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe your business and what you offer..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <h5 class="fw-bold mb-3 border-bottom pb-2">Contact & Location</h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="ContactEmail" class="form-label fw-semibold"></label>
                                <input asp-for="ContactEmail" class="form-control" type="email" />
                                <span asp-validation-for="ContactEmail" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ContactPhone" class="form-label fw-semibold"></label>
                                <input asp-for="ContactPhone" class="form-control" />
                                <span asp-validation-for="ContactPhone" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Website" class="form-label fw-semibold"></label>
                            <input asp-for="Website" class="form-control" placeholder="https://..." />
                            <span asp-validation-for="Website" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-semibold"></label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-4">
                                <label asp-for="City" class="form-label fw-semibold"></label>
                                <input asp-for="City" class="form-control" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="State" class="form-label fw-semibold"></label>
                                <input asp-for="State" class="form-control" />
                                <span asp-validation-for="State" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="PostalCode" class="form-label fw-semibold"></label>
                                <input asp-for="PostalCode" class="form-control" />
                                <span asp-validation-for="PostalCode" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="MyBusiness" class="btn btn-outline-secondary me-md-2">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

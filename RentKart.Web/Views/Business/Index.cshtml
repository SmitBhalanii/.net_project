@model RentKart.Web.ViewModels.Business.BusinessListViewModel
@{
    ViewData["Title"] = "Rental Businesses";
}

<div class="container mt-4 mb-5">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h2 class="fw-bold">Find Rental Businesses</h2>
            <p class="text-muted">Discover top-rated rental providers near you.</p>
        </div>
        <div class="col-md-6">
            <form asp-action="Index" method="get" class="d-flex gap-2 justify-content-md-end bg-light p-3 rounded">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control border-start-0" placeholder="Search businesses..." value="@Model.SearchTerm" />
                </div>
                <select name="city" class="form-select w-auto" style="min-width: 150px;">
                    <option value="">All Cities</option>
                    @foreach (var city in Model.AvailableCities)
                    {
                        var isSelected = Model.City == city ? "selected" : "";
                        <!option value="@city" @isSelected>@city</!option>
                    }
                </select>
                <button type="submit" class="btn btn-primary px-4">Search</button>
            </form>
        </div>
    </div>

    @if (!Model.Businesses.Any())
    {
        <div class="text-center py-5 bg-light rounded mt-4">
            <i class="bi bi-shop text-muted" style="font-size: 3rem;"></i>
            <h4 class="mt-3">No rental businesses found.</h4>
            <p class="text-muted">Try adjusting your search criteria or city filter.</p>
            <a asp-action="Index" class="btn btn-outline-primary mt-2">Clear Filters</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mt-2">
            @foreach (var business in Model.Businesses)
            {
                <div class="col">
                    <partial name="_BusinessCard" model="business" />
                </div>
            }
        </div>
    }
</div>

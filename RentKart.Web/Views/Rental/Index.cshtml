@model IEnumerable<RentKart.Core.Entities.Rental>
@{
    ViewData["Title"] = "Business Rentals";
}

<div class="d-flex justify-content-between align-items-center mt-3 mb-4">
    <h2>Rental Management</h2>
    
    <form asp-action="SearchByBooking" method="post" class="d-flex w-50">
        <input type="text" name="bookingNumber" class="form-control me-2" placeholder="Scan or Enter Booking Number (e.g. BKG-...)" required />
        <button type="submit" class="btn btn-primary">Search</button>
    </form>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Booking</th>
            <th>Customer</th>
            <th>Equipment</th>
            <th>Code</th>
            <th>Expected Return</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rental in Model)
        {
            <tr>
                <td>@rental.Booking.BookingNumber</td>
                <td>@rental.Customer.Email</td>
                <td>@rental.Equipment.Name</td>
                <td>@rental.Equipment.EquipmentCode</td>
                <td>@rental.ExpectedReturnDate.ToString("dd MMM yyyy")</td>
                <td>
                    <span class="badge bg-secondary">@rental.Status</span>
                    @if (rental.Status == RentKart.Core.Enums.RentalStatus.Active && DateTime.UtcNow.Date > rental.ExpectedReturnDate.Date)
                    {
                        <span class="badge bg-danger">Overdue</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@rental.Id" class="btn btn-sm btn-outline-info">View</a>
                    
                    @if (rental.Status == RentKart.Core.Enums.RentalStatus.ReadyForPickup)
                    {
                        <a asp-action="Issue" asp-route-id="@rental.Id" class="btn btn-sm btn-success">Issue</a>
                    }
                    @if (rental.Status == RentKart.Core.Enums.RentalStatus.Active)
                    {
                        <a asp-action="Return" asp-route-id="@rental.Id" class="btn btn-sm btn-primary">Receive</a>
                    }
                    @if (rental.Status == RentKart.Core.Enums.RentalStatus.Returned)
                    {
                        <form asp-action="Complete" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@rental.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-success" onclick="return confirm('Complete this rental?');">Complete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

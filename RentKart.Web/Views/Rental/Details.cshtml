@model RentKart.Core.Entities.Rental
@{
    ViewData["Title"] = "Rental Details";
}

<div class="container mt-4">
    <h2>Rental Details</h2>
    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">Booking: @Model.Booking.BookingNumber</h5>
            <div class="row mt-3">
                <div class="col-md-6">
                    <p><strong>Equipment:</strong> @Model.Equipment.Name</p>
                    <p><strong>Equipment Code:</strong> @Model.Equipment.EquipmentCode</p>
                    <p><strong>Business:</strong> @Model.Business.BusinessName</p>
                    <p><strong>Customer:</strong> @Model.Customer.Email</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Status:</strong> <span class="badge bg-primary">@Model.Status</span></p>
                    <p><strong>Payment Status:</strong> @Model.Booking.PaymentStatus</p>
                    <p><strong>Rental Start:</strong> @Model.Booking.StartDate.ToString("dd MMM yyyy")</p>
                    <p><strong>Expected Return:</strong> @Model.ExpectedReturnDate.ToString("dd MMM yyyy")</p>
                    <p><strong>Actual Return:</strong> @(Model.ActualReturnDate?.ToString("dd MMM yyyy") ?? "Not returned yet")</p>
                </div>
            </div>

            <hr />
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Condition at Issue:</strong> @(Model.ConditionAtIssue?.ToString() ?? "N/A")</p>
                    <p><strong>Issue Notes:</strong> @(Model.IssueNotes ?? "None")</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Condition at Return:</strong> @(Model.ConditionAtReturn?.ToString() ?? "N/A")</p>
                    <p><strong>Damage Found:</strong> @(Model.DamageFound ? "Yes" : "No")</p>
                    <p><strong>Return Notes:</strong> @(Model.ReturnNotes ?? "None")</p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="mt-4 d-flex gap-2">
        @if (User.IsInRole("Customer"))
        {
            if (Model.Status == RentKart.Core.Enums.RentalStatus.ReadyForPickup)
            {
                <div class="card border-success mb-3 me-3" style="max-width: 200px;">
                    <div class="card-header bg-success text-white text-center">Pickup QR Code</div>
                    <div class="card-body text-center p-2">
                        <img src="@Url.Action("PickupQr", "Rental", new { id = Model.Id })" alt="Pickup QR Code" class="img-fluid" />
                        <small class="text-muted d-block mt-1">Show this to the vendor</small>
                    </div>
                </div>
            }
            <a asp-action="MyRentals" class="btn btn-secondary align-self-start">Back to My Rentals</a>
        }
        else
        {
            if (Model.Status == RentKart.Core.Enums.RentalStatus.ReadyForPickup)
            {
                <a asp-action="Issue" asp-route-id="@Model.Id" class="btn btn-success align-self-start">Issue Equipment</a>
            }
            else if (Model.Status == RentKart.Core.Enums.RentalStatus.Active)
            {
                <a asp-action="Return" asp-route-id="@Model.Id" class="btn btn-warning align-self-start">Receive Equipment</a>
            }
            else if (Model.Status == RentKart.Core.Enums.RentalStatus.Returned)
            {
                <form asp-action="Complete" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-primary align-self-start" onclick="return confirm('Are you sure you want to complete this rental? Make sure all damage issues are resolved.');">Complete Rental</button>
                </form>
            }

            <a asp-action="Index" class="btn btn-secondary align-self-start">Back to Rentals</a>
        }
    </div>
</div>

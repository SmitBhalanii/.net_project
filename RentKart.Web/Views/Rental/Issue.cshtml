@model RentKart.Web.ViewModels.Rental.RentalIssueViewModel
@{
    ViewData["Title"] = "Issue Equipment";
}

<div class="container mt-4">
    <h2>Issue Equipment</h2>
    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">Booking: @Model.BookingNumber</h5>
            
            <div class="row mt-3">
                <div class="col-md-6">
                    <p><strong>Customer:</strong> @Model.CustomerName</p>
                    <p><strong>Equipment:</strong> @Model.EquipmentName</p>
                    <p><strong>Code:</strong> @Model.EquipmentCode</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Rental Period:</strong> @Model.RentalStart.ToString("dd MMM yyyy") to @Model.RentalEnd.ToString("dd MMM yyyy")</p>
                    <p><strong>Payment:</strong> <span class="badge bg-success">@Model.PaymentStatus</span></p>
                </div>
            </div>

            <hr />
            <form asp-action="Issue" method="post">
                <input type="hidden" asp-for="RentalId" />
                
                <div class="mb-3">
                    <label class="form-label">Customer Verified:</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="customerVerified" required>
                        <label class="form-check-label" for="customerVerified">
                            I verify the customer's identity and booking information.
                        </label>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ConditionAtIssue" class="form-label"></label>
                    <select asp-for="ConditionAtIssue" asp-items="Html.GetEnumSelectList<RentKart.Core.Enums.EquipmentCondition>()" class="form-select"></select>
                </div>

                <div class="mb-3">
                    <label asp-for="IssueNotes" class="form-label"></label>
                    <textarea asp-for="IssueNotes" class="form-control" rows="3"></textarea>
                </div>

                <button type="submit" class="btn btn-primary">Confirm Equipment Issue</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

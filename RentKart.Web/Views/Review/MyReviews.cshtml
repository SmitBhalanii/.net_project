@model IEnumerable<RentKart.Core.Entities.Review>

@{
    ViewData["Title"] = "My Reviews";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Reviews</h2>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You haven't written any reviews yet. Complete a rental to leave your first review!
    </div>
}
else
{
    <div class="row">
        @foreach (var review in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-truncate" title="@review.Equipment.Name">
                            <i class="bi bi-box me-1"></i> @review.Equipment.Name
                        </span>
                        <span>
                            @if (review.Status == RentKart.Core.Enums.ReviewStatus.Published)
                            {
                                <span class="badge bg-success">Published</span>
                            }
                            else if (review.Status == RentKart.Core.Enums.ReviewStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (review.Status == RentKart.Core.Enums.ReviewStatus.Rejected)
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Hidden</span>
                            }
                        </span>
                    </div>
                    <div class="card-body">
                        <p class="mb-1 text-muted small"><i class="bi bi-shop me-1"></i> @review.Business.BusinessName</p>
                        
                        <div class="d-flex justify-content-between mb-3">
                            <div>
                                <small class="text-muted d-block">Equipment</small>
                                <span class="text-warning">
                                    @for (int i = 0; i < review.EquipmentRating; i++)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                </span>
                            </div>
                            <div class="text-end">
                                <small class="text-muted d-block">Business</small>
                                <span class="text-warning">
                                    @for (int i = 0; i < review.BusinessRating; i++)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                </span>
                            </div>
                        </div>

                        <h6 class="card-title fw-bold">@review.Title</h6>
                        <p class="card-text text-muted">@(review.Comment?.Length > 100 ? review.Comment.Substring(0, 100) + "..." : review.Comment)</p>
                    </div>
                    <div class="card-footer bg-white text-muted small d-flex justify-content-between align-items-center">
                        <span>Submitted on @review.CreatedAt.ToString("MMM dd, yyyy")</span>
                        <a asp-action="Edit" asp-route-id="@review.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@model IEnumerable<RentKart.Core.Entities.Review>

@{
    ViewData["Title"] = "Review Moderation";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Review Moderation</h2>
</div>

@if (!Model.Any())
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle me-1"></i> No pending reviews to moderate.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Customer</th>
                    <th>Equipment</th>
                    <th>Business</th>
                    <th>Ratings (Eq/Biz)</th>
                    <th>Review Content</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var review in Model)
                {
                    <tr>
                        <td>
                            @review.Customer.FirstName @review.Customer.LastName<br/>
                            <small class="text-muted">@review.Customer.Email</small>
                        </td>
                        <td>@review.Equipment.Name</td>
                        <td>@review.Business.BusinessName</td>
                        <td>
                            <span class="text-warning">
                                @review.EquipmentRating <i class="bi bi-star-fill"></i>
                            </span><br/>
                            <span class="text-warning">
                                @review.BusinessRating <i class="bi bi-star-fill"></i>
                            </span>
                        </td>
                        <td style="max-width: 300px;">
                            <strong>@review.Title</strong><br/>
                            <p class="mb-0 small text-truncate" title="@review.Comment">@review.Comment</p>
                        </td>
                        <td>@review.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                        <td>
                            <div class="btn-group">
                                <form asp-action="Moderate" method="post" class="d-inline">
                                    <input type="hidden" name="reviewId" value="@review.Id" />
                                    <input type="hidden" name="status" value="@RentKart.Core.Enums.ReviewStatus.Published" />
                                    <button type="submit" class="btn btn-sm btn-success" title="Approve">
                                        <i class="bi bi-check-circle"></i>
                                    </button>
                                </form>
                                <form asp-action="Moderate" method="post" class="d-inline ms-1">
                                    <input type="hidden" name="reviewId" value="@review.Id" />
                                    <input type="hidden" name="status" value="@RentKart.Core.Enums.ReviewStatus.Rejected" />
                                    <button type="submit" class="btn btn-sm btn-danger" title="Reject">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </form>
                                <form asp-action="Moderate" method="post" class="d-inline ms-1">
                                    <input type="hidden" name="reviewId" value="@review.Id" />
                                    <input type="hidden" name="status" value="@RentKart.Core.Enums.ReviewStatus.Hidden" />
                                    <button type="submit" class="btn btn-sm btn-secondary" title="Hide">
                                        <i class="bi bi-eye-slash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

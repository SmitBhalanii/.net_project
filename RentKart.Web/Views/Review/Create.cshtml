@model RentKart.Web.ViewModels.Review.CreateReviewViewModel

@{
    ViewData["Title"] = "Write a Review";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">How was your rental?</h4>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-4">
                        You are reviewing the rental for <strong>@Model.EquipmentName</strong> provided by <strong>@Model.BusinessName</strong>.
                        <br />
                        <small>Only customers who completed this rental can review it.</small>
                    </p>

                    <form asp-action="Create" method="post">
                        <input type="hidden" asp-for="RentalId" />
                        <input type="hidden" asp-for="BookingId" />
                        <input type="hidden" asp-for="EquipmentId" />
                        <input type="hidden" asp-for="BusinessId" />

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h5>Equipment Rating</h5>
                                <div class="form-group">
                                    <select asp-for="EquipmentRating" class="form-select">
                                        <option value="">-- Select Rating --</option>
                                        <option value="5">5 - Excellent</option>
                                        <option value="4">4 - Good</option>
                                        <option value="3">3 - Average</option>
                                        <option value="2">2 - Poor</option>
                                        <option value="1">1 - Terrible</option>
                                    </select>
                                    <span asp-validation-for="EquipmentRating" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h5>Business Rating</h5>
                                <div class="form-group">
                                    <select asp-for="BusinessRating" class="form-select">
                                        <option value="">-- Select Rating --</option>
                                        <option value="5">5 - Excellent</option>
                                        <option value="4">4 - Good</option>
                                        <option value="3">3 - Average</option>
                                        <option value="2">2 - Poor</option>
                                        <option value="1">1 - Terrible</option>
                                    </select>
                                    <span asp-validation-for="BusinessRating" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Review Title</label>
                            <input asp-for="Title" class="form-control" placeholder="Summarize your experience..." />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Comment" class="form-label fw-bold"></label>
                            <textarea asp-for="Comment" class="form-control" rows="5" placeholder="Share details about the equipment condition, performance, and the service provided by the business..."></textarea>
                            <span asp-validation-for="Comment" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Submit Review</button>
                            <a asp-action="MyRentals" asp-controller="Rental" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

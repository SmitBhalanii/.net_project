@model RentKart.Web.ViewModels.Notification.NotificationListViewModel

@{
    ViewData["Title"] = "Notifications";
    var unreadOnly = ViewData["UnreadOnly"] as bool? ?? false;
    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col d-flex justify-content-between align-items-center">
            <h2>Notifications <span class="badge bg-primary" id="unread-count-badge">@Model.UnreadCount Unread</span></h2>
            <div>
                <a asp-action="Preferences" class="btn btn-outline-secondary me-2"><i class="bi bi-gear"></i> Preferences</a>
                @if (Model.UnreadCount > 0)
                {
                    <form asp-controller="Notification" asp-action="MarkAllAsRead" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-primary">Mark all as read</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <ul class="nav nav-pills">
                <li class="nav-item">
                    <a class="nav-link @(unreadOnly ? "" : "active")" asp-action="Index" asp-route-unreadOnly="false">All</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(unreadOnly ? "active" : "")" asp-action="Index" asp-route-unreadOnly="true">Unread</a>
                </li>
            </ul>
        </div>
    </div>

    @if (!Model.Notifications.Any())
    {
        <div class="alert alert-info">
            You don't have any @(unreadOnly ? "unread " : "")notifications yet.
        </div>
    }
    else
    {
        <div class="list-group mb-4">
            @foreach (var notification in Model.Notifications)
            {
                var readClass = notification.IsRead ? "" : "list-group-item-light border-primary bg-primary bg-opacity-10";
                var icon = notification.NotificationType switch
                {
                    RentKart.Core.Enums.NotificationType.BookingCreated => "bi-calendar-check text-primary",
                    RentKart.Core.Enums.NotificationType.BookingApproved => "bi-calendar-check-fill text-success",
                    RentKart.Core.Enums.NotificationType.BookingRejected => "bi-calendar-x-fill text-danger",
                    RentKart.Core.Enums.NotificationType.BookingCancelled => "bi-calendar-x text-muted",
                    RentKart.Core.Enums.NotificationType.PaymentRequired => "bi-credit-card text-warning",
                    RentKart.Core.Enums.NotificationType.PaymentSuccessful => "bi-credit-card-fill text-success",
                    RentKart.Core.Enums.NotificationType.PaymentFailed => "bi-credit-card-2-front-fill text-danger",
                    RentKart.Core.Enums.NotificationType.PickupReady => "bi-box-seam text-info",
                    RentKart.Core.Enums.NotificationType.EquipmentIssued => "bi-tools text-primary",
                    RentKart.Core.Enums.NotificationType.RentalStarted => "bi-play-circle text-success",
                    RentKart.Core.Enums.NotificationType.RentalDueSoon => "bi-clock-history text-warning",
                    RentKart.Core.Enums.NotificationType.RentalOverdue => "bi-exclamation-triangle-fill text-danger",
                    RentKart.Core.Enums.NotificationType.EquipmentReturned => "bi-check-circle text-success",
                    RentKart.Core.Enums.NotificationType.RentalCompleted => "bi-check2-all text-success",
                    RentKart.Core.Enums.NotificationType.ReviewSubmitted => "bi-star text-primary",
                    RentKart.Core.Enums.NotificationType.ReviewApproved => "bi-star-fill text-success",
                    RentKart.Core.Enums.NotificationType.ReviewRejected => "bi-star-half text-danger",
                    _ => "bi-bell text-secondary"
                };

                <div class="list-group-item list-group-item-action d-flex gap-3 py-3 @readClass" id="notification-@notification.Id">
                    <i class="bi @icon fs-4"></i>
                    <div class="d-flex gap-2 w-100 justify-content-between">
                        <div>
                            <h6 class="mb-0 fw-bold">@notification.Title</h6>
                            <p class="mb-0">@notification.Message</p>
                            @if (!string.IsNullOrEmpty(notification.ActionUrl))
                            {
                                <a href="@notification.ActionUrl" class="btn btn-sm btn-link p-0 mt-1 stretched-link" onclick="markAsReadAndNavigate(event, @notification.Id, '@notification.ActionUrl')">View Details <i class="bi bi-arrow-right"></i></a>
                            }
                        </div>
                        <div class="text-nowrap text-end position-relative z-1">
                            <small class="opacity-50 text-nowrap d-block">@notification.CreatedAt.ToString("g")</small>
                            <div class="mt-2">
                                @if (!notification.IsRead)
                                {
                                    <button class="btn btn-sm btn-link text-decoration-none p-0 me-2" onclick="markAsRead(@notification.Id)">Mark Read</button>
                                }
                                <form asp-controller="Notification" asp-action="Delete" asp-route-id="@notification.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0 p-0" title="Delete"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-unreadOnly="@unreadOnly">Previous</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Page @currentPage</span>
                </li>
                <li class="page-item @(Model.Notifications.Count() < 20 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-unreadOnly="@unreadOnly">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
        function markAsRead(id) {
            fetch(/Notification/MarkAsRead/, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            }).then(response => {
                if (response.ok) {
                    var el = document.getElementById(
otification-);
                    if (el) {
                        el.classList.remove('list-group-item-light', 'border-primary', 'bg-primary', 'bg-opacity-10');
                        var markReadBtn = el.querySelector('button[onclick^="markAsRead"]');
                        if (markReadBtn) markReadBtn.remove();
                    }
                    var countBadge = document.getElementById('unread-count-badge');
                    if (countBadge) {
                        var count = parseInt(countBadge.innerText) || 0;
                        if (count > 0) {
                            countBadge.innerText = (count - 1) + " Unread";
                        }
                    }
                }
            });
        }

        function markAsReadAndNavigate(e, id, url) {
            e.preventDefault();
            fetch(/Notification/MarkAsRead/, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            }).then(() => {
                window.location.href = url;
            }).catch(() => {
                window.location.href = url;
            });
        }
    </script>
}


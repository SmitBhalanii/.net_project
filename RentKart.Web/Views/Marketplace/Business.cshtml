@model RentKart.Core.Entities.Business
@{
    ViewData["Title"] = Model.BusinessName;
}

<div class="container mt-4 mb-5">
    <div class="row">
        <!-- Business Info Sidebar -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm text-center">
                <div class="card-body py-5">
                    @if (!string.IsNullOrEmpty(Model.LogoPath))
                    {
                        <img src="@Model.LogoPath" class="rounded-circle mb-3 border" style="width: 120px; height: 120px; object-fit: cover;" alt="@Model.BusinessName">
                    }
                    else
                    {
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 120px; height: 120px; font-size: 3rem;">
                            @Model.BusinessName.Substring(0, 1).ToUpper()
                        </div>
                    }
                    <h2 class="card-title h4 fw-bold">@Model.BusinessName</h2>
                    <p class="text-muted"><i class="bi bi-geo-alt"></i> @Model.City, @Model.State</p>
                    
                    <hr />
                    <p class="text-start">@Model.Description</p>
                    <hr />
                    
                    <div class="text-start">
                        <h6 class="fw-bold">Contact & Location</h6>
                        <address class="small text-muted mb-0">
                            @Model.Address<br />
                            @Model.City, @Model.State @Model.PostalCode
                        </address>
                    </div>
                </div>
            </div>
        </div>

        <!-- Business Equipment -->
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="mb-0">Equipment by @Model.BusinessName</h3>
                <a asp-action="Search" asp-route-businessId="@Model.Id" class="btn btn-outline-primary btn-sm">View All in Search</a>
            </div>

            @if (Model.Equipment != null && Model.Equipment.Any(e => e.IsActive))
            {
                <div class="row row-cols-1 row-cols-md-2 g-4">
                    @foreach (var item in Model.Equipment.Where(e => e.IsActive))
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm">
                                <div style="height: 200px; background-color: #f8f9fa; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                    <i class="bi bi-camera text-muted" style="font-size: 3rem;"></i>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title text-truncate">@item.Name</h5>
                                    <h6 class="fw-bold mt-2">₹@item.RentalPrice.ToString("N0") / @item.RentalPeriod.ToString().ToLower()</h6>
                                </div>
                                <div class="card-footer bg-white border-top-0 d-grid">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">View Details</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info border">
                    <i class="bi bi-info-circle me-1"></i> This business has no active equipment listed at the moment.
                </div>
            }
        </div>
    </div>
</div>

@model RentKart.Core.Entities.Equipment
@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-transparent p-0 mb-3">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Marketplace</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-decoration-none text-muted">@Model.Category.Name</a></li>
            <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">@Model.Name</li>
        </ol>
    </nav>
    
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h1 class="fw-bold mb-2">@Model.Name</h1>
            <p class="text-muted mb-0"><i class="bi bi-geo-alt me-1"></i> @Model.City, @Model.State</p>
        </div>
        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Customer"))
        {
            @if (ViewBag.IsInWishlist)
            {
                <form asp-controller="Wishlist" asp-action="Remove" method="post" class="m-0">
                    <input type="hidden" name="equipmentId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <button type="submit" class="btn btn-outline-danger px-4 rounded-pill">
                        <i class="bi bi-heart-fill"></i> Saved
                    </button>
                </form>
            }
            else
            {
                <form asp-controller="Wishlist" asp-action="Add" method="post" class="m-0">
                    <input type="hidden" name="equipmentId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <button type="submit" class="btn btn-outline-secondary px-4 rounded-pill shadow-sm">
                        <i class="bi bi-heart"></i> Save
                    </button>
                </form>
            }
        }
    </div>

    <div class="row mt-4">
        <div class="col-md-7 mb-4">
            @if (Model.EquipmentImages != null && Model.EquipmentImages.Any())
            {
                var primaryImage = Model.EquipmentImages.FirstOrDefault(img => img.IsPrimary) ?? Model.EquipmentImages.First();
                <div class="mb-3 rk-card border-0">
                    <img src="@primaryImage.ImagePath" class="img-fluid w-100" alt="@Model.Name" style="max-height: 500px; object-fit: cover;">
                </div>
                
                @if (Model.EquipmentImages.Count > 1)
                {
                    <div class="d-flex gap-2 overflow-auto py-2">
                        @foreach (var img in Model.EquipmentImages)
                        {
                            <img src="@img.ImagePath" class="img-thumbnail border-0 rounded" alt="Thumbnail" style="height: 100px; width: 140px; object-fit: cover; cursor: pointer;">
                        }
                    </div>
                }
            }
            else
            {
                <div class="bg-light text-center d-flex align-items-center justify-content-center rk-card border-0" style="height: 400px;">
                    <i class="bi bi-camera text-muted fs-1 d-block mb-2"></i>
                </div>
            }

            <div class="mt-5 pb-4 border-bottom">
                <h4 class="fw-bold mb-3">Description</h4>
                <p class="text-secondary" style="white-space: pre-line; font-size: 1.05rem; line-height: 1.6;">@Model.Description</p>
            </div>
            
            <div class="mt-4 pb-4 border-bottom">
                <h4 class="fw-bold mb-3">Specifications</h4>
                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small text-uppercase fw-bold mb-1">Brand</div>
                        <div class="fw-semibold">@Model.Brand</div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small text-uppercase fw-bold mb-1">Model</div>
                        <div class="fw-semibold">@Model.Model</div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small text-uppercase fw-bold mb-1">Condition</div>
                        <div class="fw-semibold">@Model.Condition.ToString()</div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small text-uppercase fw-bold mb-1">Available Quantity</div>
                        <div class="fw-semibold">@Model.Quantity</div>
                    </div>
                </div>
            </div>

            <div class="mt-5">
                <h4 class="mb-4">Reviews & Ratings</h4>
                @if (ViewBag.ReviewCount > 0)
                {
                    <div class="card bg-light mb-4 shadow-sm border-0">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-4 text-center border-end">
                                    <h1 class="display-4 fw-bold mb-0">@ViewBag.AverageRating.ToString("0.0")</h1>
                                    <div class="text-warning mb-2 fs-5">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Round(ViewBag.AverageRating))
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star"></i>
                                            }
                                        }
                                    </div>
                                    <p class="text-muted mb-0">Based on @ViewBag.ReviewCount reviews</p>
                                </div>
                                <div class="col-md-8">
                                    @{
                                        var distribution = (Dictionary<int, int>)ViewBag.RatingDistribution;
                                        foreach (var kvp in distribution)
                                        {
                                            var percentage = ViewBag.ReviewCount > 0 ? (kvp.Value * 100.0 / ViewBag.ReviewCount) : 0;
                                            <div class="d-flex align-items-center mb-1">
                                                <span class="text-muted small me-2" style="width: 30px;">@kvp.Key <i class="bi bi-star-fill text-warning"></i></span>
                                                <div class="progress flex-grow-1" style="height: 8px;">
                                                    <div class="progress-bar bg-warning" role="progressbar" style="width: @percentage%" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                                <span class="text-muted small ms-2" style="width: 25px;">@kvp.Value</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="review-list">
                        @foreach (var review in (IEnumerable<RentKart.Core.Entities.Review>)ViewBag.Reviews)
                        {
                            <div class="card mb-3 border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between mb-2">
                                        <div>
                                            <h6 class="mb-0 fw-bold">@review.Customer.FirstName @review.Customer.LastName.Substring(0, 1).</h6>
                                            <small class="text-muted">@review.CreatedAt.ToString("MMMM dd, yyyy")</small>
                                        </div>
                                        <div class="text-warning">
                                            @for (int i = 0; i < review.EquipmentRating; i++)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                        </div>
                                    </div>
                                    <h6 class="fw-bold mt-2">@review.Title</h6>
                                    <p class="mb-0 text-muted">@review.Comment</p>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-light border">
                        <i class="bi bi-info-circle me-1"></i> No reviews yet. Be the first to review after renting!
                    </div>
                }
            </div>
        </div>

        <div class="col-md-5">
            <div class="rk-card sticky-top" style="top: 2rem;">
                <div class="rk-card-body p-4">
                    <h2 class="fw-bold text-dark mb-1">@Model.RentalPrice.ToString("C") <span class="text-muted fw-normal fs-5">/ @Model.RentalPeriod</span></h2>
                    <p class="text-muted small mb-4">Security Deposit: @Model.SecurityDeposit.ToString("C")</p>
                    
                    <div class="d-grid gap-3 mb-4">
                        @if (Model.IsActive)
                        {
                            <a asp-controller="Booking" asp-action="Create" asp-route-equipmentId="@Model.Id" class="btn btn-primary btn-lg fw-bold">Request Rental</a>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-lg" disabled>Currently Unavailable</button>
                        }
                        <button class="btn btn-outline-primary btn-lg fw-bold">Contact Owner</button>
                    </div>
                    
                    <hr class="my-4" style="border-color: var(--rk-border);" />
                    
                    <h5 class="fw-bold mb-3">Owner Information</h5>
                    <div class="d-flex align-items-center mb-4">
                        @if (!string.IsNullOrEmpty(Model.Business.LogoPath))
                        {
                            <img src="@Model.Business.LogoPath" class="rounded-circle me-3 border" style="width: 56px; height: 56px; object-fit: cover;" alt="@Model.Business.BusinessName">
                        }
                        else
                        {
                            <div class="bg-light text-secondary rounded-circle d-flex align-items-center justify-content-center me-3 border" style="width: 56px; height: 56px; font-size: 1.5rem; font-weight: 600;">
                                @Model.Business.BusinessName.Substring(0, 1).ToUpper()
                            </div>
                        }
                        <div>
                            <h6 class="mb-1 fw-bold fs-5">@Model.Business.BusinessName</h6>
                            <small class="text-muted">Joined @Model.Business.CreatedAt.Year</small>
                        </div>
                    </div>
                    
                    <div class="p-3 bg-light rounded-3 mb-4 border">
                        <h6 class="fw-bold mb-2 small text-uppercase text-muted">Pickup Location</h6>
                        <address class="mb-0 text-dark">
                            @Model.Business.Address<br />
                            @Model.Business.City, @Model.Business.State @Model.Business.PostalCode
                        </address>
                    </div>

                    <a asp-controller="Business" asp-action="Details" asp-route-id="@Model.BusinessId" class="text-center d-block fw-semibold text-decoration-none">View Business Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>

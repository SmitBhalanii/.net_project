@model RentKart.Core.Entities.Equipment
@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Marketplace</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-route-categoryId="@Model.CategoryId">@Model.Category.Name</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>
    
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@Model.Name</h2>
        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Customer"))
        {
            @if (ViewBag.IsInWishlist)
            {
                <form asp-controller="Wishlist" asp-action="Remove" method="post" class="m-0">
                    <input type="hidden" name="equipmentId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-heart-fill"></i> Remove from Wishlist
                    </button>
                </form>
            }
            else
            {
                <form asp-controller="Wishlist" asp-action="Add" method="post" class="m-0">
                    <input type="hidden" name="equipmentId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-heart"></i> Add to Wishlist
                    </button>
                </form>
            }
        }
    </div>

    <div class="row mt-4">
        <div class="col-md-7 mb-4">
            @if (Model.EquipmentImages != null && Model.EquipmentImages.Any())
            {
                var primaryImage = Model.EquipmentImages.FirstOrDefault(img => img.IsPrimary) ?? Model.EquipmentImages.First();
                <div class="mb-3">
                    <img src="@primaryImage.ImagePath" class="img-fluid rounded shadow-sm w-100" alt="@Model.Name" style="max-height: 500px; object-fit: cover;">
                </div>
                
                @if (Model.EquipmentImages.Count > 1)
                {
                    <div class="d-flex gap-2 overflow-auto py-2">
                        @foreach (var img in Model.EquipmentImages)
                        {
                            <img src="@img.ImagePath" class="img-thumbnail rounded" alt="Thumbnail" style="height: 80px; width: 120px; object-fit: cover; cursor: pointer;">
                        }
                    </div>
                }
            }
            else
            {
                <div class="bg-light text-center d-flex align-items-center justify-content-center rounded" style="height: 400px;">
                    <h3 class="text-muted">No Images Available</h3>
                </div>
            }

            <div class="mt-5">
                <h4 class="mb-3">Description</h4>
                <p style="white-space: pre-line;">@Model.Description</p>
            </div>
            
            <div class="mt-5">
                <h4 class="mb-3">Specifications</h4>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Brand</span>
                        <strong>@Model.Brand</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Model</span>
                        <strong>@Model.Model</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Condition</span>
                        <strong>@Model.Condition.ToString()</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Available Quantity</span>
                        <strong>@Model.Quantity</strong>
                    </li>
                </ul>
            </div>

            <div class="mt-5">
                <h4 class="mb-4">Reviews & Ratings</h4>
                @if (ViewBag.ReviewCount > 0)
                {
                    <div class="card bg-light mb-4 shadow-sm border-0">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-4 text-center border-end">
                                    <h1 class="display-4 fw-bold mb-0">@ViewBag.AverageRating.ToString("0.0")</h1>
                                    <div class="text-warning mb-2 fs-5">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Round(ViewBag.AverageRating))
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star"></i>
                                            }
                                        }
                                    </div>
                                    <p class="text-muted mb-0">Based on @ViewBag.ReviewCount reviews</p>
                                </div>
                                <div class="col-md-8">
                                    @{
                                        var distribution = (Dictionary<int, int>)ViewBag.RatingDistribution;
                                        foreach (var kvp in distribution)
                                        {
                                            var percentage = ViewBag.ReviewCount > 0 ? (kvp.Value * 100.0 / ViewBag.ReviewCount) : 0;
                                            <div class="d-flex align-items-center mb-1">
                                                <span class="text-muted small me-2" style="width: 30px;">@kvp.Key <i class="bi bi-star-fill text-warning"></i></span>
                                                <div class="progress flex-grow-1" style="height: 8px;">
                                                    <div class="progress-bar bg-warning" role="progressbar" style="width: @percentage%" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                                <span class="text-muted small ms-2" style="width: 25px;">@kvp.Value</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="review-list">
                        @foreach (var review in (IEnumerable<RentKart.Core.Entities.Review>)ViewBag.Reviews)
                        {
                            <div class="card mb-3 border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between mb-2">
                                        <div>
                                            <h6 class="mb-0 fw-bold">@review.Customer.FirstName @review.Customer.LastName.Substring(0, 1).</h6>
                                            <small class="text-muted">@review.CreatedAt.ToString("MMMM dd, yyyy")</small>
                                        </div>
                                        <div class="text-warning">
                                            @for (int i = 0; i < review.EquipmentRating; i++)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                        </div>
                                    </div>
                                    <h6 class="fw-bold mt-2">@review.Title</h6>
                                    <p class="mb-0 text-muted">@review.Comment</p>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-light border">
                        <i class="bi bi-info-circle me-1"></i> No reviews yet. Be the first to review after renting!
                    </div>
                }
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm sticky-top" style="top: 2rem;">
                <div class="card-body p-4">
                    <h2 class="card-title text-primary mb-1">@Model.RentalPrice.ToString("C") <small class="text-muted fs-5">/ @Model.RentalPeriod</small></h2>
                    <p class="text-muted small mb-4">Security Deposit: @Model.SecurityDeposit.ToString("C")</p>
                    
                    <div class="d-grid gap-2 mb-4">
                        @if (Model.IsActive)
                        {
                            <a asp-controller="Booking" asp-action="Create" asp-route-equipmentId="@Model.Id" class="btn btn-primary btn-lg fw-bold shadow">Rent Now</a>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-lg" disabled>Currently Unavailable</button>
                        }
                    </div>
                    
                    <hr class="my-4" />
                    
                    <h5 class="mb-3">Provider Information</h5>
                    <div class="d-flex align-items-center mb-3">
                        @if (!string.IsNullOrEmpty(Model.Business.LogoPath))
                        {
                            <img src="@Model.Business.LogoPath" class="rounded-circle me-3 border" style="width: 50px; height: 50px; object-fit: cover;" alt="@Model.Business.BusinessName">
                        }
                        else
                        {
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; font-size: 1.5rem;">
                                @Model.Business.BusinessName.Substring(0, 1).ToUpper()
                            </div>
                        }
                        <div>
                            <h6 class="mb-0">@Model.Business.BusinessName</h6>
                            <small class="text-muted"><i class="bi bi-geo-alt"></i> @Model.City, @Model.State</small>
                        </div>
                    </div>
                    
                    <div class="bg-light p-3 rounded mb-3">
                        <h6 class="mb-2">Pickup Location</h6>
                        <address class="mb-0 small text-muted">
                            @Model.Business.Address<br />
                            @Model.Business.City, @Model.Business.State @Model.Business.PostalCode
                        </address>
                    </div>

                    <a asp-controller="Business" asp-action="Details" asp-route-id="@Model.BusinessId" class="btn btn-outline-secondary w-100">View Business Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>

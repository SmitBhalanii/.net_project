@model IEnumerable<RentKart.Core.Entities.Equipment>
@{
    ViewData["Title"] = "Marketplace";
}

<div class="container-fluid bg-light border-bottom">
    <div class="container py-3">
        <h2 class="fw-bold mb-0 text-secondary">Browse Rentals</h2>
        <p class="text-muted mb-0">Find exactly what you need in your area.</p>
    </div>
</div>

<div class="container mt-4 mb-5">
    <div class="row">
        <!-- LEFT SIDEBAR -->
        <div class="col-lg-3 mb-4">
            <div class="rk-card p-4 sticky-top" style="top: 20px; z-index: 10;">
                <h5 class="fw-bold mb-3">Filters</h5>
                <form asp-action="Index" method="get">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Search</label>
                        <input type="text" name="searchTerm" class="form-control" placeholder="Keywords..." value="@ViewBag.SearchTerm" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Category</label>
                        <select name="categoryId" class="form-select">
                            <option value="">All Categories</option>
                            @foreach (var cat in ViewBag.Categories)
                            {
                                var isSelected = ViewBag.CategoryId == cat.Id ? "selected" : "";
                                <!option value="@cat.Id" @isSelected>@cat.Name</!option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Location</label>
                        <input type="text" name="city" class="form-control" placeholder="City or Zip" value="@ViewBag.City" />
                    </div>
                    <div class="mb-3 pt-2">
                        <button type="submit" class="btn btn-primary w-100">Apply Filters</button>
                        <a asp-action="Index" class="btn btn-outline-primary w-100 mt-2">Clear</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- RIGHT: Results -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted">Showing <strong>@Model.Count()</strong> results</span>
            </div>

            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                @foreach (var item in Model)
                {
                    <div class="col">
                        <div class="rk-card h-100 d-flex flex-column">
                            <div class="rk-card-img-wrapper position-relative">
                                @if (item.EquipmentImages != null && item.EquipmentImages.Any())
                                {
                                    var primaryImage = item.EquipmentImages.FirstOrDefault(img => img.IsPrimary) ?? item.EquipmentImages.First();
                                    <img src="@primaryImage.ImagePath" class="rk-card-img" alt="@item.Name">
                                }
                                else
                                {
                                    <div class="d-flex h-100 w-100 align-items-center justify-content-center bg-light">
                                        <i class="bi bi-camera text-muted fs-1"></i>
                                    </div>
                                }
                                <div class="position-absolute top-0 end-0 p-2">
                                    <span class="badge bg-white text-dark shadow-sm">@item.Category.Name</span>
                                </div>
                            </div>
                            <div class="rk-card-body flex-grow-1 d-flex flex-column">
                                <h3 class="rk-card-title text-truncate" title="@item.Name">@item.Name</h3>
                                <p class="rk-card-subtitle text-truncate"><i class="bi bi-geo-alt"></i> @item.City, @item.State</p>
                                
                                <div class="mt-auto pt-2 border-top">
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <div class="rk-card-price">
                                            @item.RentalPrice.ToString("C") <span class="text-muted small fw-normal">/ @item.RentalPeriod</span>
                                        </div>
                                    </div>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary w-100 mt-3">View Details</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            
            @if (!Model.Any())
            {
                <div class="text-center py-5 bg-white rounded shadow-sm border mt-3">
                    <i class="bi bi-search text-muted mb-3 d-block" style="font-size: 3rem;"></i>
                    <h4 class="text-muted fw-bold">No rentals found</h4>
                    <p class="text-muted mb-4">Try changing your search or filters.</p>
                    <a asp-action="Index" class="btn btn-primary px-4">Clear Filters</a>
                </div>
            }
        </div>
    </div>
</div>

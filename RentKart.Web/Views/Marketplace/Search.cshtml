@model RentKart.Web.ViewModels.Marketplace.MarketplaceSearchViewModel
@{
    ViewData["Title"] = "Search Equipment";
}

<div class="container mt-4 mb-5">
    <div class="row mb-3">
        <div class="col-12">
            <h2>Search Marketplace</h2>
        </div>
    </div>

    <div class="row">
        <!-- Sidebar Filters -->
        <div class="col-lg-3 col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Filters</h5>
                    <form method="get" asp-action="Search" id="filterForm">
                        
                        <!-- Search Term -->
                        <div class="mb-3">
                            <label asp-for="SearchTerm" class="form-label">Search</label>
                            <input asp-for="SearchTerm" class="form-control" placeholder="What do you need?" />
                        </div>

                        <!-- Category -->
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label">Category</label>
                            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                                <option value="">All Categories</option>
                            </select>
                        </div>

                        <!-- Location -->
                        <div class="mb-3">
                            <label asp-for="Location" class="form-label">Location (City/Area/Zip)</label>
                            <input asp-for="Location" class="form-control" placeholder="e.g. Nadiad" />
                        </div>

                        <!-- Price -->
                        <div class="mb-3">
                            <label class="form-label">Price Range (₹/day)</label>
                            <div class="input-group mb-2">
                                <span class="input-group-text">Min</span>
                                <input asp-for="MinPrice" type="number" class="form-control" placeholder="0" min="0" />
                            </div>
                            <div class="input-group">
                                <span class="input-group-text">Max</span>
                                <input asp-for="MaxPrice" type="number" class="form-control" placeholder="5000" min="0" />
                            </div>
                        </div>

                        <!-- Rating -->
                        <div class="mb-3">
                            <label asp-for="MinRating" class="form-label">Minimum Rating</label>
                            <select asp-for="MinRating" class="form-select">
                                <option value="">Any Rating</option>
                                <option value="4">4+ Stars</option>
                                <option value="3">3+ Stars</option>
                                <option value="2">2+ Stars</option>
                            </select>
                        </div>

                        <!-- Dates / Availability -->
                        <div class="mb-3">
                            <label class="form-label">Availability Dates</label>
                            <input asp-for="StartDate" type="date" class="form-control mb-2" />
                            <input asp-for="EndDate" type="date" class="form-control" />
                            <small class="text-muted">Check if equipment is available for these dates.</small>
                        </div>

                        <!-- Sort By (Hidden input to preserve state) -->
                        <input type="hidden" asp-for="SortBy" id="hiddenSortBy" />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Apply Filters</button>
                            <a asp-action="Search" class="btn btn-outline-secondary">Clear Filters</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Results Section -->
        <div class="col-lg-9 col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="mb-0 text-muted">Showing @Model.Results.Count of @Model.TotalItems results</p>
                <div class="d-flex align-items-center">
                    <label class="me-2 fw-bold text-nowrap">Sort By:</label>
                    <select class="form-select w-auto" id="sortSelect" onchange="updateSort(this.value)">
                        <option value="relevance" selected="@(Model.SortBy == "relevance")">Relevance</option>
                        <option value="price-low" selected="@(Model.SortBy == "price-low")">Price: Low to High</option>
                        <option value="price-high" selected="@(Model.SortBy == "price-high")">Price: High to Low</option>
                        <option value="rating" selected="@(Model.SortBy == "rating")">Highest Rated</option>
                        <option value="newest" selected="@(Model.SortBy == "newest")">Newest</option>
                        <option value="popular" selected="@(Model.SortBy == "popular")">Most Rented</option>
                    </select>
                </div>
            </div>

            @if (!Model.Results.Any())
            {
                <div class="alert alert-info text-center py-5">
                    <h4>No equipment found.</h4>
                    <p>Try another category, change the price range, or clear filters.</p>
                    <a asp-action="Search" class="btn btn-primary mt-2">Clear Filters</a>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 mb-4">
                    @foreach (var item in Model.Results)
                    {
                        <div class="col">
                            <partial name="_EquipmentCard" model="item" />
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="javascript:goToPage(@(Model.CurrentPage - 1))">Previous</a>
                            </li>
                            
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" href="javascript:goToPage(@i)">@i</a>
                                </li>
                            }
                            
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="javascript:goToPage(@(Model.CurrentPage + 1))">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateSort(sortBy) {
            document.getElementById('hiddenSortBy').value = sortBy;
            document.getElementById('filterForm').submit();
        }

        function goToPage(page) {
            // Append page as a hidden input and submit form
            var form = document.getElementById('filterForm');
            var pageInput = document.createElement('input');
            pageInput.type = 'hidden';
            pageInput.name = 'CurrentPage';
            pageInput.value = page;
            form.appendChild(pageInput);
            form.submit();
        }
        
        // Basic validation for dates
        document.getElementById('filterForm').addEventListener('submit', function(e) {
            var start = document.getElementById('StartDate').value;
            var end = document.getElementById('EndDate').value;
            var minPrice = document.getElementById('MinPrice').value;
            var maxPrice = document.getElementById('MaxPrice').value;
            
            if (start && !end) {
                alert('Please select an end date.');
                e.preventDefault();
                return;
            }
            if (!start && end) {
                alert('Please select a start date.');
                e.preventDefault();
                return;
            }
            if (start && end && new Date(start) > new Date(end)) {
                alert('End date must be after start date.');
                e.preventDefault();
                return;
            }
            
            if (minPrice && maxPrice && parseFloat(minPrice) > parseFloat(maxPrice)) {
                alert('Minimum price cannot be greater than maximum price.');
                e.preventDefault();
                return;
            }
        });
    </script>
}

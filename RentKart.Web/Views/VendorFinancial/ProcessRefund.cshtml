@model RentKart.Core.Entities.Payment
@{
    ViewData["Title"] = "Process Refund";

}

<div class="container mt-4">
    <h2>Process Refund</h2>
    <p class="text-muted">Process a refund for Payment @Model.PaymentReference</p>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Booking Details</h5>
            <p><strong>Booking Number:</strong> @Model.Booking.BookingNumber</p>
            <p><strong>Original Payment Amount:</strong> @Model.Amount.ToString("C")</p>
            <p><strong>Security Deposit:</strong> @Model.Booking.SecurityDepositAmount.ToString("C")</p>
            <p><strong>Maximum Refund Available:</strong> <span class="text-success">@ViewBag.MaxRefund.ToString("C")</span></p>

            <hr />

            <form asp-action="ProcessRefund" method="post">
                <input type="hidden" name="paymentId" value="@Model.Id" />
                
                <div class="mb-3">
                    <label for="amount" class="form-label">Refund Amount (?)</label>
                    <input type="number" class="form-control" id="amount" name="amount" step="0.01" min="1" max="@ViewBag.MaxRefund" required />
                    <div class="form-text">You can refund up to the maximum available amount (usually to return a deposit).</div>
                </div>

                <div class="mb-3">
                    <label for="reason" class="form-label">Reason</label>
                    <textarea class="form-control" id="reason" name="reason" rows="3" required placeholder="e.g., Security deposit returned in full"></textarea>
                </div>

                <button type="submit" class="btn btn-warning">Process Refund</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

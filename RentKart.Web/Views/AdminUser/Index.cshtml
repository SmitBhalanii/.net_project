@model IEnumerable<RentKart.Core.Entities.ApplicationUser>
@inject Microsoft.AspNetCore.Identity.UserManager<RentKart.Core.Entities.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Manage Users";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-container mx-n3 mt-n3 mb-n3">
    <partial name="_AdminSidebar" />
    
    <main class="dashboard-main">
        <div class="dashboard-header d-flex justify-content-between align-items-center">
            <div>
                <h2 class="dashboard-title">Manage Users</h2>
                <p class="text-muted mb-0">Suspend or reactivate user accounts across the platform.</p>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">User</th>
                                <th>Role</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                @((user.FirstName?.FirstOrDefault() ?? user.Email?.FirstOrDefault() ?? 'U').ToString().ToUpper())
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold">@user.FirstName @user.LastName</h6>
                                                <small class="text-muted">@user.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            var isBusiness = await UserManager.IsInRoleAsync(user, RentKart.Core.Constants.RoleNames.Business);
                                            var isAdmin = await UserManager.IsInRoleAsync(user, RentKart.Core.Constants.RoleNames.Admin);
                                        }
                                        <span class="badge bg-info text-dark">@(isBusiness ? "Business" : "Customer")</span>
                                        @if (isAdmin)
                                        {
                                            <span class="badge bg-dark ms-1">Admin</span>
                                        }
                                    </td>
                                    <td>@user.PhoneNumber</td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success rounded-pill">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger rounded-pill">Suspended</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <!-- Don't allow admins to suspend themselves, or other admins (depending on business rules). Assuming we just don't let them suspend themselves -->
                                        @if (user.UserName != User.Identity?.Name)
                                        {
                                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <input type="hidden" name="isActive" value="@(user.IsActive ? "false" : "true")" />
                                                
                                                @if (user.IsActive)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to suspend this user?');">
                                                        <i class="bi bi-pause-circle me-1"></i> Suspend
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                                        <i class="bi bi-play-circle me-1"></i> Reactivate
                                                    </button>
                                                }
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <p class="text-muted mb-0">No users found.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </main>
</div>
@inject Microsoft.AspNetCore.Identity.UserManager<RentKart.Core.Entities.ApplicationUser> UserManager
